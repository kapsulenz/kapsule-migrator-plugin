#. Plugin Name of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost Migrator"
msgstr "KapsuleHost Migrator"

#. Plugin URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com/migrate"
msgstr "https://kapsulehost.com/migrate"

#. Description of the plugin
#: kapsule-migrator.php
msgid "Migrate your WordPress site to KapsuleHost, or export your site for manual migration anywhere."
msgstr "Перенесите ваш сайт WordPress на KapsuleHost или экспортируйте сайт для ручного переноса куда угодно."

#. Author of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost"
msgstr "KapsuleHost"

#. Author URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com"
msgstr "https://kapsulehost.com"

#: admin/class-admin-page.php:118
#: admin/class-admin-page.php:201
#: admin/class-admin-page.php:286
#: admin/class-admin-page.php:372
#: admin/class-admin-page.php:403
msgid "You do not have permission to do that. Ask an administrator of this site to run the migration."
msgstr "У вас нет прав для этого действия. Попросите администратора сайта выполнить перенос."

#: admin/class-admin-page.php:124
#: assets/js/migrator.js:185
msgid "Paste your migration token first. You will find it in your KapsuleHost panel under Sites, then Migrate."
msgstr "Сначала вставьте ваш токен переноса. Вы найдёте его в панели KapsuleHost в разделе Сайты, затем Перенос."

#: admin/class-admin-page.php:148
#: assets/js/migrator.js:201
msgid "We could not connect to KapsuleHost with that token. Check it and try again."
msgstr "Не удалось подключиться к KapsuleHost с этим токеном. Проверьте его и попробуйте снова."

#: admin/class-admin-page.php:211
#: admin/class-admin-page.php:294
msgid "This migration is no longer in a state we can continue from. Stop and start over to begin a clean run."
msgstr "Этот перенос больше не находится в состоянии, с которого мы можем продолжить. Остановите процесс и начните заново."

#: admin/class-admin-page.php:457
msgid "You do not have permission to download this file."
msgstr "У вас нет прав для скачивания этого файла."

#: admin/class-admin-page.php:464
msgid "That download link has expired. Reload this page and try again."
msgstr "Эта ссылка для скачивания истекла. Перезагрузите страницу и попробуйте снова."

#: admin/class-admin-page.php:469
msgid "We could not find that file. The package may have been cleaned up, so package this site again."
msgstr "Не удалось найти этот файл. Пакет мог быть удалён, создайте пакет сайта заново."

#: admin/class-admin-page.php:476
msgid "That file is no longer on this server. Package this site again to rebuild it."
msgstr "Этого файла больше нет на сервере. Создайте пакет сайта заново, чтобы восстановить его."

#: admin/class-admin-page.php:545
msgid "Move to KapsuleHost"
msgstr "Перенести на KapsuleHost"

#: admin/class-admin-page.php:546
msgid "Download a copy"
msgstr "Скачать копию"

#: admin/class-admin-page.php:551
msgid "Step 1 of 1"
msgstr "Шаг 1 из 1"

#: admin/class-admin-page.php:552
msgid "Move this site to KapsuleHost"
msgstr "Перенести этот сайт на KapsuleHost"

#: admin/class-admin-page.php:554
msgid "Paste the migration token from your KapsuleHost panel. We copy your files and your database across and leave this site exactly as it is, serving visitors the whole time."
msgstr "Вставьте токен переноса из панели KapsuleHost. Мы скопируем ваши файлы и базу данных, при этом текущий сайт останется без изменений и будет продолжать обслуживать посетителей."

#: admin/class-admin-page.php:558
msgid "Migration token"
msgstr "Токен переноса"

#: admin/class-admin-page.php:560
msgid "Paste your token"
msgstr "Вставьте ваш токен"

#: admin/class-admin-page.php:562
msgid "Find it in your panel under Sites, then Migrate. The token works once and is deleted when the move finishes."
msgstr "Найдите его в панели в разделе Сайты, затем Перенос. Токен используется один раз и удаляется после завершения переноса."

#: admin/class-admin-page.php:567
#: assets/js/migrator.js:202
#: assets/js/migrator.js:206
msgid "Start the move"
msgstr "Начать перенос"

#: admin/class-admin-page.php:577
msgid "Encrypted end to end"
msgstr "Сквозное шифрование"

#: admin/class-admin-page.php:578
msgid "This site is only ever read, never changed"
msgstr "Этот сайт только читается, никогда не изменяется"

#: admin/class-admin-page.php:579
msgid "Token deleted after use"
msgstr "Токен удаляется после использования"

#: admin/class-admin-page.php:585
msgid "No account needed"
msgstr "Не требуется аккаунт"

#: admin/class-admin-page.php:586
msgid "Download a copy of this site"
msgstr "Скачать копию этого сайта"

#: admin/class-admin-page.php:588
msgid "Package the files and database into archives you can download and take anywhere. Useful if you are moving by hand or want a copy before you change anything."
msgstr "Упакуйте файлы и базу данных в архивы, которые можно скачать и перенести куда угодно. Полезно, если вы переносите сайт вручную или хотите создать копию перед внесением изменений."

#: admin/class-admin-page.php:592
#: assets/js/migrator.js:225
#: assets/js/migrator.js:229
msgid "Package this site"
msgstr "Упаковать этот сайт"

#: admin/class-admin-page.php:602
msgid "Files stay on your server until you download them"
msgstr "Файлы остаются на вашем сервере до скачивания"

#: admin/class-admin-page.php:603
msgid "wp-config.php is left out on purpose"
msgstr "wp-config.php намеренно исключён"

#: admin/class-admin-page.php:628
msgid "Packaging your site"
msgstr "Упаковка вашего сайта"

#: admin/class-admin-page.php:629
msgid "We are building downloadable archives of your files and database. Keep this tab open."
msgstr "Мы создаём архивы ваших файлов и базы данных для скачивания. Держите эту вкладку открытой."

#: admin/class-admin-page.php:631
msgid "Looking at your site"
msgstr "Анализ вашего сайта"

#: admin/class-admin-page.php:632
msgid "We are counting your files and checking the connection to KapsuleHost. Nothing has moved yet."
msgstr "Мы подсчитываем файлы и проверяем соединение с KapsuleHost. Пока ничего не перемещено."

#: admin/class-admin-page.php:634
#: assets/js/migrator.js:332
msgid "Moving your site"
msgstr "Перенос вашего сайта"

#: admin/class-admin-page.php:635
#: assets/js/migrator.js:333
msgid "Your site is being copied across in pieces. It stays live and unchanged the whole time."
msgstr "Ваш сайт копируется по частям. Он остаётся работающим и неизменным всё это время."

#. translators: 1: current piece number, 2: total number of pieces.
#: admin/class-admin-page.php:655
#: assets/js/migrator.js:154
msgid "piece %1$s of %2$s"
msgstr "часть %1$s из %2$s"

#: admin/class-admin-page.php:669
msgid "Pieces sent"
msgstr "Отправлено частей"

#: admin/class-admin-page.php:673
msgid "Moved"
msgstr "Перенесено"

#: admin/class-admin-page.php:677
msgid "Total"
msgstr "Всего"

#: admin/class-admin-page.php:681
#: assets/js/migrator.js:335
msgid "Files"
msgstr "Файлы"

#: admin/class-admin-page.php:689
msgid "Count the files and check the connection"
msgstr "Подсчитать файлы и проверить соединение"

#: admin/class-admin-page.php:693
msgid "Copy the files across"
msgstr "Скопировать файлы"

#: admin/class-admin-page.php:697
msgid "Copy the database across"
msgstr "Скопировать базу данных"

#: admin/class-admin-page.php:701
msgid "KapsuleHost puts it together"
msgstr "KapsuleHost собирает всё вместе"

#: admin/class-admin-page.php:710
msgid "Keep this tab open. We will show your download links the moment packaging finishes."
msgstr "Держите эту вкладку открытой. Мы покажем ссылки для скачивания сразу после завершения упаковки."

#: admin/class-admin-page.php:712
msgid "<strong>Keep this tab open.</strong> The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "<strong>Держите эту вкладку открытой.</strong> Перенос выполняется отсюда, поэтому закрытие вкладки приостановит его. Ничего не потеряется: откройте эту страницу снова, и процесс продолжится с последней полученной части."

#: admin/class-admin-page.php:718
msgid "Stop and start over"
msgstr "Остановить и начать заново"

#: admin/class-admin-page.php:727
msgid "Package ready"
msgstr "Пакет готов"

#: admin/class-admin-page.php:728
msgid "Your site is packaged"
msgstr "Ваш сайт упакован"

#: admin/class-admin-page.php:730
msgid "Download the archives below and import them on your new host. This site has not been changed."
msgstr "Скачайте архивы ниже и импортируйте их на новом хостинге. Этот сайт не был изменён."

#: admin/class-admin-page.php:740
msgid "Download"
msgstr "Скачать"

#: admin/class-admin-page.php:747
msgid "Moving to KapsuleHost instead? Use the token path and we do all of this for you, with nothing to download."
msgstr "Переносите на KapsuleHost? Используйте путь с токеном, и мы сделаем всё это за вас, без необходимости что-либо скачивать."

#: admin/class-admin-page.php:751
msgid "Delete the package and start over"
msgstr "Удалить пакет и начать заново"

#: admin/class-admin-page.php:769
msgid "Move complete"
msgstr "Перенос завершён"

#: admin/class-admin-page.php:770
msgid "Your site is on KapsuleHost"
msgstr "Ваш сайт на KapsuleHost"

#. translators: %s: number of files copied, already formatted for the locale.
#: admin/class-admin-page.php:773
msgid "%s files and your database were copied and checked. Open the copy and look around before you point your domain at it."
msgstr "%s файлов и ваша база данных были скопированы и проверены. Откройте копию и осмотритесь, прежде чем направить на неё ваш домен."

#: admin/class-admin-page.php:780
msgid "Files copied"
msgstr "Скопировано файлов"

#: admin/class-admin-page.php:784
msgid "Transferred"
msgstr "Передано"

#: admin/class-admin-page.php:788
msgid "Database"
msgstr "База данных"

#: admin/class-admin-page.php:789
msgid "Copied"
msgstr "Скопирована"

#: admin/class-admin-page.php:792
msgid "Took"
msgstr "Заняло"

#. translators: %s: whole number of minutes the migration took.
#: admin/class-admin-page.php:796
msgid "%s min"
msgid_plural "%s min"
msgstr[0] "%s мин"
msgstr[1] "%s мин"
msgstr[2] "%s мин"

#: admin/class-admin-page.php:798
msgid "not recorded"
msgstr "не записано"

#: admin/class-admin-page.php:806
msgid "<strong>This site has not been changed.</strong> It is still live and serving visitors. Nothing moves for your visitors until you point your domain at the new copy."
msgstr "<strong>Этот сайт не был изменён.</strong> Он по-прежнему работает и обслуживает посетителей. Ничего не изменится для посетителей, пока вы не направите ваш домен на новую копию."

#: admin/class-admin-page.php:811
msgid "Open the migrated site"
msgstr "Открыть перенесённый сайт"

#: admin/class-admin-page.php:813
msgid "Back to my panel"
msgstr "Вернуться в панель"

#: admin/class-admin-page.php:822
msgid "Move stopped"
msgstr "Перенос остановлен"

#: admin/class-admin-page.php:823
msgid "We stopped before anything changed"
msgstr "Мы остановились до внесения изменений"

#: admin/class-admin-page.php:825
msgid "The move did not finish, so we stopped rather than leave you with half a site. Your site here is untouched and still serving visitors."
msgstr "Перенос не завершился, поэтому мы остановились, чтобы не оставить вас с половиной сайта. Ваш сайт здесь не тронут и продолжает обслуживать посетителей."

#: admin/class-admin-page.php:836
msgid "Try again"
msgstr "Попробовать снова"

#: admin/class-admin-page.php:837
msgid "Contact support"
msgstr "Связаться с поддержкой"

#: admin/class-admin-page.php:870
#: assets/js/migrator.js:443
msgid "Checking the connection"
msgstr "Проверка соединения"

#: admin/class-admin-page.php:871
#: assets/js/migrator.js:444
msgid "Counting your files"
msgstr "Подсчёт файлов"

#: admin/class-admin-page.php:872
#: assets/js/migrator.js:331
#: assets/js/migrator.js:445
msgid "Copying files"
msgstr "Копирование файлов"

#: admin/class-admin-page.php:873
#: assets/js/migrator.js:420
#: assets/js/migrator.js:446
msgid "Copying database"
msgstr "Копирование базы данных"

#: admin/class-admin-page.php:874
#: assets/js/migrator.js:447
msgid "Packaging"
msgstr "Упаковка"

#: admin/class-admin-page.php:875
msgid "Working"
msgstr "Выполнение"

#. translators: %s: a formatted number of gigabytes, e.g. "5.9".
#: admin/class-admin-page.php:889
#: assets/js/migrator.js:66
msgid "%s GB"
msgstr "%s ГБ"

#. translators: %s: a formatted number of megabytes.
#: admin/class-admin-page.php:893
#: assets/js/migrator.js:67
msgid "%s MB"
msgstr "%s МБ"

#. translators: %s: a formatted number of kilobytes.
#: admin/class-admin-page.php:897
#: assets/js/migrator.js:68
msgid "%s KB"
msgstr "%s КБ"

#. translators: %s: a formatted number of bytes.
#: admin/class-admin-page.php:900
#: assets/js/migrator.js:69
msgid "%s B"
msgstr "%s Б"

#: includes/class-packager.php:26
msgid "This server cannot create archives, so we cannot package your site. Ask your host to enable the PHP zip extension, then contact KapsuleHost support if it still fails."
msgstr "Этот сервер не может создавать архивы, поэтому мы не можем упаковать ваш сайт. Попросите ваш хостинг включить расширение PHP zip, затем свяжитесь с поддержкой KapsuleHost, если это не поможет."

#: includes/class-uploader.php:89
msgid "We could not read a prepared piece of your site from disk. Free up space on the server and start the migration again."
msgstr "Не удалось прочитать подготовленную часть вашего сайта с диска. Освободите место на сервере и начните перенос заново."

#. translators: %s: an HTTP status code.
#: includes/class-uploader.php:120
msgid "the server replied %s"
msgstr "сервер ответил %s"

#: includes/class-uploader.php:147
msgid "we could not open the prepared file"
msgstr "не удалось открыть подготовленный файл"

#. translators: %s: the size of the piece that was rejected, e.g. "50".
#: includes/class-uploader.php:188
msgid "One piece of your site (%s MB) was larger than the server would accept. This is a limit on our side, not a problem with your site. Contact support and we will raise it."
msgstr "Одна часть вашего сайта (%s МБ) оказалась больше, чем сервер может принять. Это ограничение с нашей стороны, а не проблема вашего сайта. Свяжитесь с поддержкой, и мы увеличим лимит."

#: includes/class-uploader.php:193
msgid "Your migration token is no longer valid. Generate a new one in your KapsuleHost panel and paste it in again."
msgstr "Ваш токен переноса больше не действителен. Создайте новый в панели KapsuleHost и вставьте его снова."

#: includes/class-uploader.php:195
msgid "The migration this token belongs to no longer exists. Start a new migration from your KapsuleHost panel."
msgstr "Перенос, которому принадлежит этот токен, больше не существует. Начните новый перенос из панели KapsuleHost."

#: includes/class-uploader.php:197
msgid "The server could not read one of the prepared pieces of your site. Start the migration again to rebuild it."
msgstr "Сервер не смог прочитать одну из подготовленных частей вашего сайта. Начните перенос заново, чтобы пересоздать её."

#. translators: %s: the HTTP status code the server returned.
#: includes/class-uploader.php:201
msgid "The server refused a piece of your site (code %s). Your site has not been changed. Contact support and we will look at it."
msgstr "Сервер отклонил часть вашего сайта (код %s). Ваш сайт не был изменён. Свяжитесь с поддержкой, и мы разберёмся."

#: assets/js/migrator.js:75
msgid "less than a minute left"
msgstr "осталось меньше минуты"

#. translators: %s: whole number of minutes remaining.
#: assets/js/migrator.js:80
msgid "about %s minute left"
msgid_plural "about %s minutes left"
msgstr[0] "осталась примерно %s минута"
msgstr[1] "осталось примерно %s минуты"
msgstr[2] "осталось примерно %s минут"

#. translators: %s: whole number of hours remaining.
#: assets/js/migrator.js:85
msgid "about %s hour left"
msgid_plural "about %s hours left"
msgstr[0] "остался примерно %s час"
msgstr[1] "осталось примерно %s часа"
msgstr[2] "осталось примерно %s часов"

#. translators: 1: whole hours remaining, 2: additional minutes remaining.
#: assets/js/migrator.js:88
msgid "about %1$s h %2$s min left"
msgstr "осталось примерно %1$s ч %2$s мин"

#: assets/js/migrator.js:190
msgid "Checking your site..."
msgstr "Проверка вашего сайта..."

#: assets/js/migrator.js:205
msgid "We could not reach KapsuleHost just now. Check this server can get online, then try again."
msgstr "Не удалось связаться с KapsuleHost. Проверьте, что этот сервер имеет выход в интернет, затем попробуйте снова."

#: assets/js/migrator.js:214
msgid "Packaging..."
msgstr "Упаковка..."

#: assets/js/migrator.js:224
#: assets/js/migrator.js:228
msgid "We could not start packaging. Please try again."
msgstr "Не удалось начать упаковку. Пожалуйста, попробуйте снова."

#: assets/js/migrator.js:235
msgid "Cleaning up..."
msgstr "Очистка..."

#. translators: 1: which piece is moving, 2: estimated time remaining. Joined into one line.
#: assets/js/migrator.js:262
msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

#. translators: 1: pieces sent so far, 2: total pieces.
#: assets/js/migrator.js:255
#: assets/js/migrator.js:344
msgid "%1$s / %2$s"
msgstr "%1$s / %2$s"

#. translators: %s: the HTTP status code the server returned, e.g. "502".
#: assets/js/migrator.js:316
msgid "the connection returned %s"
msgstr "соединение вернуло %s"

#: assets/js/migrator.js:318
#: assets/js/migrator.js:395
msgid "the connection dropped"
msgstr "соединение прервалось"

#: assets/js/migrator.js:326
msgid "Keep this tab open."
msgstr "Держите эту вкладку открытой."

#: assets/js/migrator.js:327
msgid "The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "Перенос выполняется отсюда, поэтому закрытие вкладки приостановит его. Ничего не потеряется: откройте эту страницу снова, и процесс продолжится с последней полученной части."

#: assets/js/migrator.js:348
msgid "Retrying"
msgstr "Повтор"

#: assets/js/migrator.js:349
msgid "The connection dropped"
msgstr "Соединение прервалось"

#. translators: %s: the number of the piece being retried.
#: assets/js/migrator.js:351
msgid "We are retrying piece %s. Everything already sent is kept, so this carries on from where it stopped rather than starting again."
msgstr "Мы повторяем отправку части %s. Всё уже отправленное сохранено, поэтому процесс продолжится с места остановки, а не начнётся заново."

#. translators: 1: the attempt about to be made, 2: total attempts allowed.
#: assets/js/migrator.js:354
msgid "Attempt"
msgstr "Попытка"

#: assets/js/migrator.js:355
msgid "Nothing has been lost. Your site is untouched and still serving visitors. If this keeps failing we will tell you exactly what to do next."
msgstr "Ничего не потеряно. Ваш сайт не тронут и продолжает обслуживать посетителей. Если это будет повторяться, мы точно скажем вам, что делать дальше."

#. translators: 1: seconds until the next attempt, 2: the attempt number, 3: total attempts.
#: assets/js/migrator.js:363
msgid "retrying in %1$s second, attempt %2$s of %3$s"
msgid_plural "retrying in %1$s seconds, attempt %2$s of %3$s"
msgstr[0] "повтор через %1$s секунду, попытка %2$s из %3$s"
msgstr[1] "повтор через %1$s секунды, попытка %2$s из %3$s"
msgstr[2] "повтор через %1$s секунд, попытка %2$s из %3$s"

#. translators: 1: the attempt number, 2: total attempts.
#: assets/js/migrator.js:368
msgid "retrying now, attempt %1$s of %2$s"
msgstr "повтор сейчас, попытка %1$s из %2$s"

#: assets/js/migrator.js:391
msgid "Paused"
msgstr "Приостановлено"

#: assets/js/migrator.js:392
msgid "We have paused the move"
msgstr "Мы приостановили перенос"

#. translators: 1: how many attempts were made, 2: why the connection failed.
#: assets/js/migrator.js:394
msgid "We could not reach KapsuleHost after %1$s tries (%2$s). Nothing is lost. Everything already copied is still there, and this site has not been changed."
msgstr "Не удалось связаться с KapsuleHost после %1$s попыток (%2$s). Ничего не потеряно. Всё уже скопированное сохранено, и этот сайт не был изменён."

#: assets/js/migrator.js:397
msgid "Stopped at"
msgstr "Остановлено на"

#. translators: %s: describes which piece the transfer stopped on, e.g. "piece 57 of 119".
