#: admin/class-admin-page.php:1537
#: assets/js/migrator.js:71
msgid "%s B"
msgstr "%s Б"

#: includes/class-packager.php:26
msgid "This server cannot create archives, so we cannot package your site. Ask your host to enable the PHP zip extension, then contact KapsuleHost support if it still fails."
msgstr "Этот сервер не может создавать архивы, поэтому мы не можем упаковать ваш сайт. Попросите хостинг-провайдера включить расширение PHP zip, затем свяжитесь со службой поддержки KapsuleHost, если проблема сохранится."

#. translators: %s: the placeholder token found in the export.
#: includes/class-packager.php:467
msgid "We built a copy of your database and then found it was not safe to send: it still contains an internal placeholder (%s) where your content has a percent sign. Sending it would have changed your links, styling and settings. Nothing has been uploaded and your site is untouched. Please contact KapsuleHost support and quote this message."
msgstr "Мы создали копию вашей базы данных и обнаружили, что её небезопасно отправлять: она всё ещё содержит внутренний символ-заполнитель (%s) там, где в содержимом используется знак процента. Отправка изменила бы ваши ссылки, стили и настройки. Ничего не было загружено, и ваш сайт не изменён. Пожалуйста, свяжитесь со службой поддержки KapsuleHost и сообщите это сообщение."

#: includes/class-uploader.php:112
msgid "We could not read a prepared piece of your site from disk. Free up space on the server and start the migration again."
msgstr "Мы не смогли прочитать подготовленную часть вашего сайта с диска. Освободите место на сервере и запустите миграцию заново."

#. translators: %s: an HTTP status code.
#: includes/class-uploader.php:135
msgid "the server replied %s"
msgstr "сервер ответил %s"

#: includes/class-uploader.php:162
msgid "we could not open the prepared file"
msgstr "мы не смогли открыть подготовленный файл"

#. translators: %s: the size of the piece that was rejected, e.g. "50".
#: includes/class-uploader.php:218
msgid "One piece of your site (%s MB) was larger than the server would accept. This is a limit on our side, not a problem with your site. Contact support and we will raise it."
msgstr "Одна часть вашего сайта (%s МБ) оказалась больше, чем сервер может принять. Это ограничение с нашей стороны, а не проблема с вашим сайтом. Свяжитесь со службой поддержки, и мы увеличим лимит."

#: includes/class-uploader.php:223
msgid "Your migration token is no longer valid. Generate a new one in your KapsuleHost panel and paste it in again."
msgstr "Ваш токен миграции больше не действителен. Создайте новый в панели KapsuleHost и вставьте его снова."

#: includes/class-uploader.php:225
msgid "The migration this token belongs to no longer exists. Start a new migration from your KapsuleHost panel."
msgstr "Миграция, к которой относится этот токен, больше не существует. Начните новую миграцию из панели KapsuleHost."

#: includes/class-uploader.php:227
msgid "The server could not read one of the prepared pieces of your site. Start the migration again to rebuild it."
msgstr "Сервер не смог прочитать одну из подготовленных частей вашего сайта. Запустите миграцию заново, чтобы пересоздать её."

#. translators: %s: the HTTP status code the server returned.
#: includes/class-uploader.php:231
msgid "The server refused a piece of your site (code %s). Your site has not been changed. Contact support and we will look at it."
msgstr "Сервер отклонил часть вашего сайта (код %s). Ваш сайт не был изменён. Свяжитесь со службой поддержки, и мы посмотрим."

#: assets/js/migrator.js:77
msgid "less than a minute left"
msgstr "осталось меньше минуты"

#. translators: %s: whole number of minutes remaining.
#: assets/js/migrator.js:82
msgid "about %s minute left"
msgid_plural "about %s minutes left"
msgstr[0] "осталась примерно %s минута"
msgstr[1] "осталось примерно %s минуты"
msgstr[2] "осталось примерно %s минут"

#. translators: %s: whole number of hours remaining.
#: assets/js/migrator.js:87
msgid "about %s hour left"
msgid_plural "about %s hours left"
msgstr[0] "остался примерно %s час"
msgstr[1] "осталось примерно %s часа"
msgstr[2] "осталось примерно %s часов"

#. translators: 1: whole hours remaining, 2: additional minutes remaining.
#: assets/js/migrator.js:90
msgid "about %1$s h %2$s min left"
msgstr "осталось примерно %1$s ч %2$s мин"

#: assets/js/migrator.js:192
msgid "Checking your site..."
msgstr "Проверяем ваш сайт..."

#: assets/js/migrator.js:207
msgid "We could not reach KapsuleHost just now. Check this server can get online, then try again."
msgstr "Не удалось связаться с KapsuleHost. Убедитесь, что сервер имеет доступ в интернет, и повторите попытку."

#: assets/js/migrator.js:216
msgid "Packaging..."
msgstr "Упаковка..."

#: assets/js/migrator.js:226
#: assets/js/migrator.js:230
msgid "We could not start packaging. Please try again."
msgstr "Не удалось начать упаковку. Пожалуйста, попробуйте ещё раз."

#: assets/js/migrator.js:237
msgid "Cleaning up..."
msgstr "Очистка..."

#. translators: 1: which piece is moving, 2: estimated time remaining. Joined into one line.
#: assets/js/migrator.js:294
msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

#. translators: %s: the HTTP status code the server returned, e.g. "502".
#: assets/js/migrator.js:361
msgid "the connection returned %s"
msgstr "соединение вернуло %s"

#: assets/js/migrator.js:363
#: assets/js/migrator.js:440
msgid "the connection dropped"
msgstr "соединение прервалось"

#: assets/js/migrator.js:371
msgid "Keep this tab open."
msgstr "Держите эту вкладку открытой."

#: assets/js/migrator.js:372
msgid "The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "Перенос управляется отсюда, поэтому закрытие вкладки приостановит его. Ничего не потеряется: откройте эту страницу снова, и процесс продолжится с последнего переданного фрагмента."

#: assets/js/migrator.js:393
msgid "Retrying"
msgstr "Повторная попытка"

#: assets/js/migrator.js:394
msgid "The connection dropped"
msgstr "Соединение прервалось"

#. translators: %s: the number of the piece being retried.
#: assets/js/migrator.js:396
msgid "We are retrying piece %s. Everything already sent is kept, so this carries on from where it stopped rather than starting again."
msgstr "Повторяем передачу фрагмента %s. Всё уже отправленное сохранено, поэтому процесс продолжится с того места, где остановился, а не начнётся заново."

#: assets/js/migrator.js:399
msgid "Attempt"
msgstr "Попытка"

#: assets/js/migrator.js:400
msgid "Nothing has been lost. Your site is untouched and still serving visitors. If this keeps failing we will tell you exactly what to do next."
msgstr "Ничего не потеряно. Ваш сайт не изменён и продолжает обслуживать посетителей. Если ошибка будет повторяться, мы точно укажем, что делать дальше."

#. translators: 1: seconds until the next attempt, 2: the attempt number, 3: total attempts.
#: assets/js/migrator.js:408
msgid "retrying in %1$s second, attempt %2$s of %3$s"
msgid_plural "retrying in %1$s seconds, attempt %2$s of %3$s"
msgstr[0] "повтор через %1$s секунду, попытка %2$s из %3$s"
msgstr[1] "повтор через %1$s секунды, попытка %2$s из %3$s"
msgstr[2] "повтор через %1$s секунд, попытка %2$s из %3$s"

#. translators: 1: the attempt number, 2: total attempts.
#: assets/js/migrator.js:413
msgid "retrying now, attempt %1$s of %2$s"
msgstr "повторяем сейчас, попытка %1$s из %2$s"

#: assets/js/migrator.js:436
msgid "Paused"
msgstr "Приостановлено"

#: assets/js/migrator.js:437
msgid "We have paused the move"
msgstr "Перенос приостановлен"

#. translators: 1: how many attempts were made, 2: why the connection failed.
#: assets/js/migrator.js:439
msgid "We could not reach KapsuleHost after %1$s tries (%2$s). Nothing is lost. Everything already copied is still there, and this site has not been changed."
msgstr "Не удалось связаться с KapsuleHost после %1$s попыток (%2$s). Ничего не потеряно. Всё уже скопированное сохранено, и этот сайт не был изменён."

#. translators: %s: describes which piece the transfer stopped on, e.g. "piece 57 of 119".
#: assets/js/migrator.js:444
msgid "paused at %s"
msgstr "приостановлено на %s"

#: assets/js/migrator.js:445
msgid "Check this server can reach the internet, then pick up where you left off. Nothing needs to be re-sent."
msgstr "Убедитесь, что сервер имеет доступ в интернет, затем продолжите с того места, где остановились. Ничего не нужно передавать заново."

#: assets/js/migrator.js:449
msgid "Pick up where it stopped"
msgstr "Продолжить с места остановки"

#: assets/js/migrator.js:478
msgid "Copying your database"
msgstr "Копируем вашу базу данных"

#: assets/js/migrator.js:479
msgid "The files are across. We are copying your database now, which is usually the quickest part."
msgstr "Файлы переданы. Сейчас копируем вашу базу данных — обычно это самая быстрая часть."

#: assets/js/migrator.js:481
#: assets/js/migrator.js:628
msgid "database"
msgstr "база данных"

#: assets/js/migrator.js:490
msgid "Handing over to KapsuleHost"
msgstr "Передаём управление KapsuleHost"

#: assets/js/migrator.js:492
msgid "everything sent"
msgstr "всё отправлено"

#: assets/js/migrator.js:521
#: assets/js/migrator.js:543
msgid "we cannot reach KapsuleHost just now, still trying"
msgstr "не удаётся связаться с KapsuleHost, продолжаем попытки"

