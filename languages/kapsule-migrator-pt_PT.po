#. Plugin Name of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost Migrator"
msgstr "KapsuleHost Migrator"

#. Plugin URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com/migrate"
msgstr "https://kapsulehost.com/migrate"

#. Description of the plugin
#: kapsule-migrator.php
msgid "Migrate your WordPress site to KapsuleHost, or export your site for manual migration anywhere."
msgstr "Migre o seu site WordPress para o KapsuleHost ou exporte o seu site para migração manual para qualquer destino."

#. Author of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost"
msgstr "KapsuleHost"

#. Author URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com"
msgstr "https://kapsulehost.com"

#: admin/class-admin-page.php:66
msgid "The migration ended in a state we do not recognise, so we stopped rather than guess. Your site here is untouched."
msgstr "A migração terminou num estado que não reconhecemos, por isso parámos em vez de adivinhar. O seu site aqui não foi alterado."

#. translators: %s: an HTTP status code, e.g. "503".
#: admin/class-admin-page.php:203
msgid "KapsuleHost answered %s when we asked about your move."
msgstr "O KapsuleHost respondeu %s quando perguntámos sobre a sua migração."

#: admin/class-admin-page.php:214
msgid "KapsuleHost sent an answer we could not read."
msgstr "O KapsuleHost enviou uma resposta que não conseguimos ler."

#: admin/class-admin-page.php:255
#: admin/class-admin-page.php:300
#: admin/class-admin-page.php:383
#: admin/class-admin-page.php:468
#: admin/class-admin-page.php:568
#: admin/class-admin-page.php:599
msgid "You do not have permission to do that. Ask an administrator of this site to run the migration."
msgstr "Não tem permissão para fazer isso. Peça a um administrador deste site para executar a migração."

#: admin/class-admin-page.php:306
#: assets/js/migrator.js:187
msgid "Paste your migration token first. You will find it in your KapsuleHost panel under Sites, then Migrate."
msgstr "Cole primeiro o seu token de migração. Encontra-o no seu painel KapsuleHost em Sites e depois Migrate."

#: admin/class-admin-page.php:330
#: assets/js/migrator.js:203
msgid "We could not connect to KapsuleHost with that token. Check it and try again."
msgstr "Não conseguimos ligar ao KapsuleHost com esse token. Verifique-o e tente novamente."

#: admin/class-admin-page.php:393
#: admin/class-admin-page.php:476
msgid "This migration is no longer in a state we can continue from. Stop and start over to begin a clean run."
msgstr "Esta migração já não está num estado a partir do qual possamos continuar. Pare e comece de novo para iniciar uma execução limpa."

#: admin/class-admin-page.php:658
msgid "You do not have permission to download this file."
msgstr "Não tem permissão para descarregar este ficheiro."

#: admin/class-admin-page.php:665
msgid "That download link has expired. Reload this page and try again."
msgstr "Essa ligação de descarga expirou. Recarregue esta página e tente novamente."

#: admin/class-admin-page.php:670
msgid "We could not find that file. The package may have been cleaned up, so package this site again."
msgstr "Não conseguimos encontrar esse ficheiro. O pacote pode ter sido eliminado, por isso empacote este site novamente."

#: admin/class-admin-page.php:677
msgid "That file is no longer on this server. Package this site again to rebuild it."
msgstr "Esse ficheiro já não está neste servidor. Empacote este site novamente para o reconstruir."

#: admin/class-admin-page.php:774
msgid "Move to KapsuleHost"
msgstr "Migrar para o KapsuleHost"

#: admin/class-admin-page.php:775
msgid "Download a copy"
msgstr "Descarregar uma cópia"

#: admin/class-admin-page.php:780
msgid "Step 1 of 1"
msgstr "Passo 1 de 1"

#: admin/class-admin-page.php:781
msgid "Move this site to KapsuleHost"
msgstr "Migrar este site para o KapsuleHost"

#: admin/class-admin-page.php:783
msgid "Paste the migration token from your KapsuleHost panel. We copy your files and your database across and leave this site exactly as it is, serving visitors the whole time."
msgstr "Cole o token de migração do seu painel KapsuleHost. Copiamos os seus ficheiros e a sua base de dados e deixamos este site exatamente como está, a servir visitantes todo o tempo."

#: admin/class-admin-page.php:787
msgid "Migration token"
msgstr "Token de migração"

#: admin/class-admin-page.php:789
msgid "Paste your token"
msgstr "Cole o seu token"

#: admin/class-admin-page.php:791
msgid "Find it in your panel under Sites, then Migrate. The token works once and is deleted when the move finishes."
msgstr "Encontra-o no seu painel em Sites e depois Migrate. O token funciona uma vez e é eliminado quando a migração termina."

#: admin/class-admin-page.php:801
msgid "How long this takes depends on how fast this server can upload. Small sites finish in a few minutes and large ones take longer; you will see a live estimate once the transfer starts. If it is interrupted, reopen this page and it carries on from the last piece that arrived."
msgstr "O tempo que isto leva depende da velocidade de envio deste servidor. Sites pequenos terminam em poucos minutos e os grandes demoram mais; verá uma estimativa em direto assim que a transferência começar. Se for interrompida, volte a abrir esta página e continua a partir da última parte que chegou."

#: admin/class-admin-page.php:806
#: assets/js/migrator.js:204
#: assets/js/migrator.js:208
msgid "Start the move"
msgstr "Iniciar a migração"

#: admin/class-admin-page.php:816
msgid "Encrypted end to end"
msgstr "Encriptado de ponta a ponta"

#: admin/class-admin-page.php:817
msgid "This site is only ever read, never changed"
msgstr "Este site é apenas lido, nunca alterado"

#: admin/class-admin-page.php:818
msgid "Token deleted after use"
msgstr "Token eliminado após utilização"

#: admin/class-admin-page.php:824
msgid "No account needed"
msgstr "Não é necessária conta"

#: admin/class-admin-page.php:825
msgid "Download a copy of this site"
msgstr "Descarregar uma cópia deste site"

#: admin/class-admin-page.php:827
msgid "Package the files and database into archives you can download and take anywhere. Useful if you are moving by hand or want a copy before you change anything."
msgstr "Empacote os ficheiros e a base de dados em arquivos que pode descarregar e levar para qualquer lugar. Útil se estiver a migrar manualmente ou quiser uma cópia antes de alterar qualquer coisa."

#: admin/class-admin-page.php:831
#: assets/js/migrator.js:227
#: assets/js/migrator.js:231
msgid "Package this site"
msgstr "Empacotar este site"

#: admin/class-admin-page.php:841
msgid "Files stay on your server until you download them"
msgstr "Os ficheiros permanecem no seu servidor até os descarregar"

#: admin/class-admin-page.php:842
msgid "wp-config.php is left out on purpose"
msgstr "wp-config.php é deixado de fora propositadamente"

#: admin/class-admin-page.php:867
msgid "Packaging your site"
msgstr "A empacotar o seu site"

#: admin/class-admin-page.php:868
msgid "We are building downloadable archives of your files and database. Keep this tab open."
msgstr "Estamos a criar arquivos transferíveis dos seus ficheiros e base de dados. Mantenha este separador aberto."

#: admin/class-admin-page.php:870
#: admin/class-admin-page.php:1274
msgid "Looking at your site"
msgstr "A examinar o seu site"

#: admin/class-admin-page.php:871
msgid "We are counting your files and checking the connection to KapsuleHost. Nothing has moved yet."
msgstr "Estamos a contar os seus ficheiros e a verificar a ligação ao KapsuleHost. Nada foi transferido ainda."

#: admin/class-admin-page.php:873
#: assets/js/migrator.js:334
msgid "Moving your site"
msgstr "A transferir o seu site"

#: admin/class-admin-page.php:874
#: assets/js/migrator.js:335
msgid "Your site is being copied across in pieces. It stays live and unchanged the whole time."
msgstr "O seu site está a ser copiado em partes. Permanece ativo e inalterado durante todo o processo."

#. translators: 1: current piece number, 2: total number of pieces.
#: admin/class-admin-page.php:893
#: assets/js/migrator.js:156
msgid "piece %1$s of %2$s"
msgstr "parte %1$s de %2$s"

#: admin/class-admin-page.php:907
msgid "Pieces sent"
msgstr "Partes enviadas"

#: admin/class-admin-page.php:911
msgid "Moved"
msgstr "Transferido"

#: admin/class-admin-page.php:915
msgid "Total"
msgstr "Total"

#: admin/class-admin-page.php:919
#: assets/js/migrator.js:337
msgid "Files"
msgstr "Ficheiros"

#: admin/class-admin-page.php:927
msgid "Count the files and check the connection"
msgstr "Contar os ficheiros e verificar a ligação"

#: admin/class-admin-page.php:931
msgid "Copy the files across"
msgstr "Copiar os ficheiros"

#: admin/class-admin-page.php:935
msgid "Copy the database across"
msgstr "Copiar a base de dados"

#: admin/class-admin-page.php:939
msgid "KapsuleHost puts it together"
msgstr "O KapsuleHost procede à montagem"

#: admin/class-admin-page.php:948
msgid "Keep this tab open. We will show your download links the moment packaging finishes."
msgstr "Mantenha este separador aberto. Mostraremos as ligações de transferência assim que o empacotamento terminar."

#: admin/class-admin-page.php:950
msgid "<strong>Keep this tab open.</strong> The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "<strong>Mantenha este separador aberto.</strong> A transferência é executada a partir daqui, pelo que fechar o separador pausa o processo. Nada se perde se o fizer: volte a abrir esta página e o processo continua a partir da última parte que chegou."

#: admin/class-admin-page.php:956
msgid "Stop and start over"
msgstr "Parar e recomeçar"

#: admin/class-admin-page.php:965
msgid "Package ready"
msgstr "Pacote pronto"

#: admin/class-admin-page.php:966
msgid "Your site is packaged"
msgstr "O seu site está empacotado"

#: admin/class-admin-page.php:968
msgid "Download the archives below and import them on your new host. This site has not been changed."
msgstr "Transfira os arquivos abaixo e importe-os no seu novo alojamento. Este site não foi alterado."

#: admin/class-admin-page.php:978
msgid "Download"
msgstr "Transferir"

#: admin/class-admin-page.php:985
msgid "Moving to KapsuleHost instead? Use the token path and we do all of this for you, with nothing to download."
msgstr "Vai transferir para o KapsuleHost? Utilize o método de token e faremos tudo isto por si, sem necessidade de transferências."

#: admin/class-admin-page.php:989
msgid "Delete the package and start over"
msgstr "Eliminar o pacote e recomeçar"

#: admin/class-admin-page.php:1007
#: admin/class-admin-page.php:1091
msgid "Move stopped"
msgstr "Transferência interrompida"

#: admin/class-admin-page.php:1008
msgid "We stopped before anything changed"
msgstr "Parámos antes de qualquer alteração"

#: admin/class-admin-page.php:1010
msgid "The move did not finish, so we stopped rather than leave you with half a site. Your site here is untouched and still serving visitors."
msgstr "A transferência não terminou, pelo que parámos em vez de deixá-lo com metade de um site. O seu site aqui permanece intacto e continua a servir visitantes."

#: admin/class-admin-page.php:1021
msgid "Try again"
msgstr "Tentar novamente"

#: admin/class-admin-page.php:1022
#: admin/class-admin-page.php:1121
#: admin/class-admin-page.php:1139
msgid "Contact support"
msgstr "Contactar o suporte"

#: admin/class-admin-page.php:1062
msgid "Checking"
msgstr "A verificar"

#: admin/class-admin-page.php:1063
msgid "Your files are with KapsuleHost"
msgstr "Os seus ficheiros estão no KapsuleHost"

#: admin/class-admin-page.php:1064
msgid "Everything uploaded from this site. We cannot reach KapsuleHost right now to tell you what has happened since, so we will not guess: open your panel to see where the move has got to."
msgstr "Tudo foi carregado a partir deste site. Não conseguimos contactar o KapsuleHost neste momento para informá-lo do que aconteceu desde então, por isso não vamos especular: abra o seu painel para ver o ponto em que a transferência se encontra."

#: admin/class-admin-page.php:1073
msgid "This site has not been changed and is still serving visitors, whatever the move is doing."
msgstr "Este site não foi alterado e continua a servir visitantes, independentemente do estado da transferência."

#: admin/class-admin-page.php:1076
msgid "Check again"
msgstr "Verificar novamente"

#: admin/class-admin-page.php:1077
msgid "Open my panel"
msgstr "Abrir o meu painel"

#: admin/class-admin-page.php:1092
msgid "The move did not finish"
msgstr "A mudança não foi concluída"

#: admin/class-admin-page.php:1093
msgid "Your files reached KapsuleHost, but putting the site together did not finish. Nothing here has changed: this site is untouched and still serving visitors, and nothing has moved for anyone visiting it."
msgstr "Os seus ficheiros chegaram ao KapsuleHost, mas a montagem do site não foi concluída. Nada aqui foi alterado: este site permanece intacto e continua a servir visitantes, e nada mudou para quem o visita."

#: admin/class-admin-page.php:1098
#: assets/js/migrator.js:399
msgid "Stopped at"
msgstr "Parou em"

#: admin/class-admin-page.php:1102
msgid "Files placed"
msgstr "Ficheiros colocados"

#: admin/class-admin-page.php:1103
msgid "Yes"
msgstr "Sim"

#: admin/class-admin-page.php:1103
msgid "No"
msgstr "Não"

#: admin/class-admin-page.php:1106
#: admin/class-admin-page.php:1232
msgid "Database"
msgstr "Base de dados"

#: admin/class-admin-page.php:1107
#: admin/class-admin-page.php:1233
msgid "Imported"
msgstr "Importada"

#: admin/class-admin-page.php:1107
#: admin/class-admin-page.php:1233
msgid "Not imported"
msgstr "Não importada"

#: admin/class-admin-page.php:1120
msgid "See the details in my panel"
msgstr "Ver os detalhes no meu painel"

#: admin/class-admin-page.php:1122
msgid "Start over from here"
msgstr "Recomeçar a partir daqui"

#: admin/class-admin-page.php:1134
msgid "Needs a look"
msgstr "Requer atenção"

#: admin/class-admin-page.php:1135
msgid "Part of your site moved"
msgstr "Parte do seu site foi transferida"

#: admin/class-admin-page.php:1136
msgid "Some of the move finished and some of it did not, so we are not calling it done. Your panel lists exactly what came across and what is still here. This site is untouched and still serving visitors."
msgstr "Parte da mudança foi concluída e outra parte não, pelo que não a consideramos terminada. O seu painel indica exatamente o que foi transferido e o que permanece aqui. Este site permanece intacto e continua a servir visitantes."

#: admin/class-admin-page.php:1138
msgid "See what moved"
msgstr "Ver o que foi transferido"

#: admin/class-admin-page.php:1154
#: admin/class-admin-page.php:1317
msgid "Working"
msgstr "A processar"

#: admin/class-admin-page.php:1155
msgid "KapsuleHost is putting your site together"
msgstr "O KapsuleHost está a montar o seu site"

#: admin/class-admin-page.php:1156
msgid "Everything uploaded from this site. KapsuleHost is unpacking it, importing your database and checking the result. We will show you the outcome here, and it is safe to close this tab."
msgstr "Tudo foi enviado a partir deste site. O KapsuleHost está a descompactar, a importar a sua base de dados e a verificar o resultado. Mostraremos o resultado aqui, e pode fechar este separador sem problema."

#: admin/class-admin-page.php:1170
msgid "<strong>This site has not been changed.</strong> It is still live and serving visitors, and nothing moves for them until you point your domain at the new copy."
msgstr "<strong>Este site não foi alterado.</strong> Continua ativo e a servir visitantes, e nada muda para eles até que aponte o seu domínio para a nova cópia."

#: admin/class-admin-page.php:1174
msgid "Follow it in my panel"
msgstr "Acompanhar no meu painel"

#: admin/class-admin-page.php:1213
msgid "Move complete"
msgstr "Mudança concluída"

#: admin/class-admin-page.php:1214
msgid "Your site is on KapsuleHost"
msgstr "O seu site está no KapsuleHost"

#. translators: %s: number of files this site sent, already formatted for the locale.
#: admin/class-admin-page.php:1217
msgid "KapsuleHost has finished putting your site together from the %s files this site sent. Open the copy and look around before you point your domain at it."
msgstr "O KapsuleHost terminou de montar o seu site a partir dos %s ficheiros que este site enviou. Abra a cópia e explore-a antes de apontar o seu domínio para ela."

#: admin/class-admin-page.php:1224
msgid "Files sent"
msgstr "Ficheiros enviados"

#: admin/class-admin-page.php:1228
msgid "Transferred"
msgstr "Transferido"

#: admin/class-admin-page.php:1236
msgid "Your copy"
msgstr "A sua cópia"

#: admin/class-admin-page.php:1237
msgid "in your panel"
msgstr "no seu painel"

#: admin/class-admin-page.php:1243
msgid "<strong>This site has not been changed.</strong> It is still live and serving visitors. Nothing moves for your visitors until you point your domain at the new copy."
msgstr "<strong>Este site não foi alterado.</strong> Continua ativo e a servir visitantes. Nada muda para os seus visitantes até que aponte o seu domínio para a nova cópia."

#: admin/class-admin-page.php:1248
msgid "Open the migrated site"
msgstr "Abrir o site migrado"

#: admin/class-admin-page.php:1251
msgid "See the move in my panel"
msgstr "Ver a mudança no meu painel"

#: admin/class-admin-page.php:1253
msgid "Back to my panel"
msgstr "Voltar ao meu painel"

#: admin/class-admin-page.php:1271
msgid "Waiting to start"
msgstr "A aguardar início"

#: admin/class-admin-page.php:1272
msgid "Checking what arrived"
msgstr "A verificar o que chegou"

#: admin/class-admin-page.php:1273
msgid "Connecting"
msgstr "A ligar"

#: admin/class-admin-page.php:1275
msgid "Building your new environment"
msgstr "A construir o seu novo ambiente"

#: admin/class-admin-page.php:1276
msgid "Moving your files to the server"
msgstr "A transferir os seus ficheiros para o servidor"

#: admin/class-admin-page.php:1277
msgid "Unpacking your files"
msgstr "A descompactar os seus ficheiros"

#: admin/class-admin-page.php:1278
msgid "Putting the files in place"
msgstr "A colocar os ficheiros no lugar"

#: admin/class-admin-page.php:1279
#: admin/class-admin-page.php:1313
#: assets/js/migrator.js:333
#: assets/js/migrator.js:522
msgid "Copying files"
msgstr "A copiar ficheiros"

#: admin/class-admin-page.php:1280
msgid "Importing your database"
msgstr "A importar a sua base de dados"

#: admin/class-admin-page.php:1281
msgid "Rewriting the addresses in your site"
msgstr "A reescrever os endereços no seu site"

#: admin/class-admin-page.php:1282
msgid "Checking the result serves"
msgstr "A verificar se o resultado funciona"

#: admin/class-admin-page.php:1283
msgid "Finished"
msgstr "Concluído"

#: admin/class-admin-page.php:1311
#: assets/js/migrator.js:520
msgid "Checking the connection"
msgstr "A verificar a ligação"

#: admin/class-admin-page.php:1312
#: assets/js/migrator.js:521
msgid "Counting your files"
msgstr "A contar os seus ficheiros"

#: admin/class-admin-page.php:1314
#: assets/js/migrator.js:434
#: assets/js/migrator.js:523
msgid "Copying database"
msgstr "A copiar base de dados"

#: admin/class-admin-page.php:1315
#: assets/js/migrator.js:524
msgid "KapsuleHost is working on it"
msgstr "A KapsuleHost está a trabalhar nisso"

#: admin/class-admin-page.php:1316
#: assets/js/migrator.js:525
msgid "Packaging"
msgstr "A empacotar"

#. translators: %s: a formatted number of gigabytes, e.g. "5.9".
#: admin/class-admin-page.php:1331
#: assets/js/migrator.js:68
msgid "%s GB"
msgstr "%s GB"

#. translators: %s: a formatted number of megabytes.
#: admin/class-admin-page.php:1335
#: assets/js/migrator.js:69
msgid "%s MB"
msgstr "%s MB"

#. translators: %s: a formatted number of kilobytes.
#: admin/class-admin-page.php:1339
#: assets/js/migrator.js:70
msgid "%s KB"
msgstr "%s KB"

#. translators: %s: a formatted number of bytes.
#: admin/class-admin-page.php:1342
#: assets/js/migrator.js:71
msgid "%s B"
msgstr "%s B"

#: includes/class-packager.php:26
msgid "This server cannot create archives, so we cannot package your site. Ask your host to enable the PHP zip extension, then contact KapsuleHost support if it still fails."
msgstr "Este servidor não consegue criar arquivos, pelo que não podemos empacotar o seu site. Peça ao seu fornecedor de alojamento para ativar a extensão PHP zip e depois contacte o suporte da KapsuleHost se continuar a falhar."

#: includes/class-uploader.php:112
msgid "We could not read a prepared piece of your site from disk. Free up space on the server and start the migration again."
msgstr "Não foi possível ler uma parte preparada do seu site a partir do disco. Liberte espaço no servidor e inicie a migração novamente."

#. translators: %s: an HTTP status code.
#: includes/class-uploader.php:135
msgid "the server replied %s"
msgstr "o servidor respondeu %s"

#: includes/class-uploader.php:162
msgid "we could not open the prepared file"
msgstr "não foi possível abrir o ficheiro preparado"

#. translators: %s: the size of the piece that was rejected, e.g. "50".
#: includes/class-uploader.php:218
msgid "One piece of your site (%s MB) was larger than the server would accept. This is a limit on our side, not a problem with your site. Contact support and we will raise it."
msgstr "Uma parte do seu site (%s MB) era maior do que o servidor aceitaria. Este é um limite do nosso lado, não um problema com o seu site. Contacte o suporte e aumentaremos o limite."

#: includes/class-uploader.php:223
msgid "Your migration token is no longer valid. Generate a new one in your KapsuleHost panel and paste it in again."
msgstr "O seu token de migração já não é válido. Gere um novo no seu painel KapsuleHost e insira-o novamente."

#: includes/class-uploader.php:225
msgid "The migration this token belongs to no longer exists. Start a new migration from your KapsuleHost panel."
msgstr "A migração a que este token pertence já não existe. Inicie uma nova migração a partir do seu painel KapsuleHost."

#: includes/class-uploader.php:227
msgid "The server could not read one of the prepared pieces of your site. Start the migration again to rebuild it."
msgstr "O servidor não conseguiu ler uma das partes preparadas do seu site. Inicie a migração novamente para reconstruí-la."

#. translators: %s: the HTTP status code the server returned.
#: includes/class-uploader.php:231
msgid "The server refused a piece of your site (code %s). Your site has not been changed. Contact support and we will look at it."
msgstr "O servidor recusou uma parte do seu site (código %s). O seu site não foi alterado. Contacte o suporte e iremos analisar."

#: assets/js/migrator.js:77
msgid "less than a minute left"
msgstr "menos de um minuto restante"

#. translators: %s: whole number of minutes remaining.
#: assets/js/migrator.js:82
msgid "about %s minute left"
msgid_plural "about %s minutes left"
msgstr[0] "cerca de %s minuto restante"
msgstr[1] "cerca de %s minutos restantes"

#. translators: %s: whole number of hours remaining.
#: assets/js/migrator.js:87
msgid "about %s hour left"
msgid_plural "about %s hours left"
msgstr[0] "cerca de %s hora restante"
msgstr[1] "cerca de %s horas restantes"

#. translators: 1: whole hours remaining, 2: additional minutes remaining.
#: assets/js/migrator.js:90
msgid "about %1$s h %2$s min left"
msgstr "cerca de %1$s h %2$s min restantes"

#: assets/js/migrator.js:192
msgid "Checking your site..."
msgstr "A verificar o seu site..."

#: assets/js/migrator.js:207
msgid "We could not reach KapsuleHost just now. Check this server can get online, then try again."
msgstr "Não foi possível contactar a KapsuleHost neste momento. Verifique se este servidor consegue aceder à Internet e tente novamente."

#: assets/js/migrator.js:216
msgid "Packaging..."
msgstr "A empacotar..."

#: assets/js/migrator.js:226
#: assets/js/migrator.js:230
msgid "We could not start packaging. Please try again."
msgstr "Não foi possível iniciar o empacotamento. Por favor, tente novamente."

#: assets/js/migrator.js:237
msgid "Cleaning up..."
msgstr "A limpar..."

#. translators: 1: which piece is moving, 2: estimated time remaining. Joined into one line.
#: assets/js/migrator.js:264
msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

#. translators: %s: the HTTP status code the server returned, e.g. "502".
#: assets/js/migrator.js:318
msgid "the connection returned %s"
msgstr "a ligação devolveu %s"

#: assets/js/migrator.js:320
#: assets/js/migrator.js:397
msgid "the connection dropped"
msgstr "a ligação caiu"

#: assets/js/migrator.js:328
msgid "Keep this tab open."
msgstr "Mantenha este separador aberto."

#: assets/js/migrator.js:329
msgid "The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "A transferência é executada a partir daqui, pelo que fechar o separador pausa-a. Nada se perde se o fizer: reabra esta página e continua a partir da última parte que chegou."

#: assets/js/migrator.js:350
msgid "Retrying"
msgstr "A tentar novamente"

#: assets/js/migrator.js:351
msgid "The connection dropped"
msgstr "A ligação caiu"

#. translators: %s: the number of the piece being retried.
#: assets/js/migrator.js:353
msgid "We are retrying piece %s. Everything already sent is kept, so this carries on from where it stopped rather than starting again."
msgstr "Estamos a tentar novamente a parte %s. Tudo o que já foi enviado está guardado, pelo que isto continua de onde parou em vez de recomeçar."

#: assets/js/migrator.js:356
msgid "Attempt"
msgstr "Tentativa"

#: assets/js/migrator.js:357
msgid "Nothing has been lost. Your site is untouched and still serving visitors. If this keeps failing we will tell you exactly what to do next."
msgstr "Nada se perdeu. O seu site não foi alterado e continua a servir visitantes. Se isto continuar a falhar, dir-lhe-emos exactamente o que fazer a seguir."

#. translators: 1: seconds until the next attempt, 2: the attempt number, 3: total attempts.
#: assets/js/migrator.js:365
msgid "retrying in %1$s second, attempt %2$s of %3$s"
msgid_plural "retrying in %1$s seconds, attempt %2$s of %3$s"
msgstr[0] "a tentar novamente dentro de %1$s segundo, tentativa %2$s de %3$s"
msgstr[1] "a tentar novamente dentro de %1$s segundos, tentativa %2$s de %3$s"

#. translators: 1: the attempt number, 2: total attempts.
#: assets/js/migrator.js:370
msgid "retrying now, attempt %1$s of %2$s"
msgstr "a tentar agora, tentativa %1$s de %2$s"

#: assets/js/migrator.js:393
msgid "Paused"
msgstr "Pausado"

#: assets/js/migrator.js:394
msgid "We have paused the move"
msgstr "Pausámos a transferência"

#. translators: 1: how many attempts were made, 2: why the connection failed.
#: assets/js/migrator.js:396
msgid "We could not reach KapsuleHost after %1$s tries (%2$s). Nothing is lost. Everything already copied is still there, and this site has not been changed."
msgstr "Não conseguimos contactar a KapsuleHost após %1$s tentativas (%2$s). Nada se perdeu. Tudo o que já foi copiado continua lá, e este site não foi alterado."

#. translators: %s: describes which piece the transfer stopped on, e.g. "piece 57 of 119".
#: assets/js/migrator.js:401
msgid "paused at %s"
msgstr "pausado em %s"

#: assets/js/migrator.js:402
msgid "Check this server can reach the internet, then pick up where you left off. Nothing needs to be re-sent."
msgstr "Verifique se este servidor consegue aceder à internet e depois retome de onde parou. Nada precisa de ser reenviado."

#: assets/js/migrator.js:406
msgid "Pick up where it stopped"
msgstr "Retomar de onde parou"

#: assets/js/migrator.js:435
msgid "Copying your database"
msgstr "A copiar a sua base de dados"

#: assets/js/migrator.js:436
msgid "The files are across. We are copying your database now, which is usually the quickest part."
msgstr "Os ficheiros foram transferidos. Estamos agora a copiar a sua base de dados, o que é normalmente a parte mais rápida."

#: assets/js/migrator.js:438
#: assets/js/migrator.js:585
msgid "database"
msgstr "base de dados"

#: assets/js/migrator.js:447
msgid "Handing over to KapsuleHost"
msgstr "A transferir para a KapsuleHost"

#: assets/js/migrator.js:449
msgid "everything sent"
msgstr "tudo enviado"

#: assets/js/migrator.js:478
#: assets/js/migrator.js:500
msgid "we cannot reach KapsuleHost just now, still trying"
msgstr "não conseguimos contactar a KapsuleHost neste momento, ainda a tentar"

#: assets/js/migrator.js:507
msgid "Checking..."
msgstr "A verificar..."
