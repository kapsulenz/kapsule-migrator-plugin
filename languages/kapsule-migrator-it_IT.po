#. Plugin Name of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost Migrator"
msgstr "KapsuleHost Migrator"

#. Plugin URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com/migrate"
msgstr "https://kapsulehost.com/migrate"

#. Description of the plugin
#: kapsule-migrator.php
msgid "Migrate your WordPress site to KapsuleHost, or export your site for manual migration anywhere."
msgstr "Migri il suo sito WordPress su KapsuleHost, oppure esporti il suo sito per una migrazione manuale ovunque."

#. Author of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost"
msgstr "KapsuleHost"

#. Author URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com"
msgstr "https://kapsulehost.com"

#: admin/class-admin-page.php:123
#: admin/class-admin-page.php:206
#: admin/class-admin-page.php:291
#: admin/class-admin-page.php:377
#: admin/class-admin-page.php:408
msgid "You do not have permission to do that. Ask an administrator of this site to run the migration."
msgstr "Non ha i permessi per farlo. Chieda a un amministratore di questo sito di eseguire la migrazione."

#: admin/class-admin-page.php:129
#: assets/js/migrator.js:187
msgid "Paste your migration token first. You will find it in your KapsuleHost panel under Sites, then Migrate."
msgstr "Incolli prima il suo token di migrazione. Lo troverà nel suo pannello KapsuleHost sotto Siti, poi Migra."

#: admin/class-admin-page.php:153
#: assets/js/migrator.js:203
msgid "We could not connect to KapsuleHost with that token. Check it and try again."
msgstr "Non siamo riusciti a connetterci a KapsuleHost con quel token. Lo verifichi e riprovi."

#: admin/class-admin-page.php:216
#: admin/class-admin-page.php:299
msgid "This migration is no longer in a state we can continue from. Stop and start over to begin a clean run."
msgstr "Questa migrazione non è più in uno stato dal quale possiamo continuare. Si fermi e ricominci per iniziare una nuova esecuzione pulita."

#: admin/class-admin-page.php:462
msgid "You do not have permission to download this file."
msgstr "Non ha i permessi per scaricare questo file."

#: admin/class-admin-page.php:469
msgid "That download link has expired. Reload this page and try again."
msgstr "Quel link di download è scaduto. Ricarichi questa pagina e riprovi."

#: admin/class-admin-page.php:474
msgid "We could not find that file. The package may have been cleaned up, so package this site again."
msgstr "Non abbiamo trovato quel file. Il pacchetto potrebbe essere stato rimosso, quindi impacchetti nuovamente questo sito."

#: admin/class-admin-page.php:481
msgid "That file is no longer on this server. Package this site again to rebuild it."
msgstr "Quel file non è più su questo server. Impacchetti nuovamente questo sito per ricostruirlo."

#: admin/class-admin-page.php:550
msgid "Move to KapsuleHost"
msgstr "Sposta su KapsuleHost"

#: admin/class-admin-page.php:551
msgid "Download a copy"
msgstr "Scarica una copia"

#: admin/class-admin-page.php:556
msgid "Step 1 of 1"
msgstr "Passaggio 1 di 1"

#: admin/class-admin-page.php:557
msgid "Move this site to KapsuleHost"
msgstr "Sposti questo sito su KapsuleHost"

#: admin/class-admin-page.php:559
msgid "Paste the migration token from your KapsuleHost panel. We copy your files and your database across and leave this site exactly as it is, serving visitors the whole time."
msgstr "Incolli il token di migrazione dal suo pannello KapsuleHost. Copiamo i suoi file e il suo database e lasciamo questo sito esattamente com'è, servendo i visitatori per tutto il tempo."

#: admin/class-admin-page.php:563
msgid "Migration token"
msgstr "Token di migrazione"

#: admin/class-admin-page.php:565
msgid "Paste your token"
msgstr "Incolli il suo token"

#: admin/class-admin-page.php:567
msgid "Find it in your panel under Sites, then Migrate. The token works once and is deleted when the move finishes."
msgstr "Lo trovi nel suo pannello sotto Siti, poi Migra. Il token funziona una sola volta e viene cancellato quando il trasferimento è completato."

#: admin/class-admin-page.php:577
msgid "How long this takes depends on how fast this server can upload. Small sites finish in a few minutes and large ones take longer; you will see a live estimate once the transfer starts. If it is interrupted, reopen this page and it carries on from the last piece that arrived."
msgstr "Il tempo necessario dipende dalla velocità di caricamento di questo server. I siti piccoli terminano in pochi minuti e quelli grandi richiedono più tempo; vedrà una stima in tempo reale una volta avviato il trasferimento. Se viene interrotto, riapra questa pagina e riprenderà dall'ultimo pezzo arrivato."

#: admin/class-admin-page.php:582
#: assets/js/migrator.js:204
#: assets/js/migrator.js:208
msgid "Start the move"
msgstr "Avvia il trasferimento"

#: admin/class-admin-page.php:592
msgid "Encrypted end to end"
msgstr "Crittografato end-to-end"

#: admin/class-admin-page.php:593
msgid "This site is only ever read, never changed"
msgstr "Questo sito viene solo letto, mai modificato"

#: admin/class-admin-page.php:594
msgid "Token deleted after use"
msgstr "Token cancellato dopo l'uso"

#: admin/class-admin-page.php:600
msgid "No account needed"
msgstr "Nessun account necessario"

#: admin/class-admin-page.php:601
msgid "Download a copy of this site"
msgstr "Scarichi una copia di questo sito"

#: admin/class-admin-page.php:603
msgid "Package the files and database into archives you can download and take anywhere. Useful if you are moving by hand or want a copy before you change anything."
msgstr "Impacchetti i file e il database in archivi che può scaricare e portare ovunque. Utile se sta trasferendo manualmente o vuole una copia prima di apportare modifiche."

#: admin/class-admin-page.php:607
#: assets/js/migrator.js:227
#: assets/js/migrator.js:231
msgid "Package this site"
msgstr "Impacchetta questo sito"

#: admin/class-admin-page.php:617
msgid "Files stay on your server until you download them"
msgstr "I file restano sul suo server finché non li scarica"

#: admin/class-admin-page.php:618
msgid "wp-config.php is left out on purpose"
msgstr "wp-config.php è escluso intenzionalmente"

#: admin/class-admin-page.php:643
msgid "Packaging your site"
msgstr "Impacchettamento del suo sito"

#: admin/class-admin-page.php:644
msgid "We are building downloadable archives of your files and database. Keep this tab open."
msgstr "Stiamo creando archivi scaricabili dei suoi file e database. Mantenga aperta questa scheda."

#: admin/class-admin-page.php:646
msgid "Looking at your site"
msgstr "Analisi del suo sito"

#: admin/class-admin-page.php:647
msgid "We are counting your files and checking the connection to KapsuleHost. Nothing has moved yet."
msgstr "Stiamo contando i suoi file e verificando la connessione a KapsuleHost. Niente è stato ancora spostato."

#: admin/class-admin-page.php:649
#: assets/js/migrator.js:334
msgid "Moving your site"
msgstr "Trasferimento del suo sito"

#: admin/class-admin-page.php:650
#: assets/js/migrator.js:335
msgid "Your site is being copied across in pieces. It stays live and unchanged the whole time."
msgstr "Il suo sito viene copiato in parti. Rimane attivo e invariato per tutto il tempo."

#. translators: 1: current piece number, 2: total number of pieces.
#: admin/class-admin-page.php:670
#: assets/js/migrator.js:156
msgid "piece %1$s of %2$s"
msgstr "parte %1$s di %2$s"

#: admin/class-admin-page.php:684
msgid "Pieces sent"
msgstr "Parti inviate"

#: admin/class-admin-page.php:688
msgid "Moved"
msgstr "Trasferiti"

#: admin/class-admin-page.php:692
msgid "Total"
msgstr "Totale"

#: admin/class-admin-page.php:696
#: assets/js/migrator.js:337
msgid "Files"
msgstr "File"

#: admin/class-admin-page.php:704
msgid "Count the files and check the connection"
msgstr "Conta i file e verifica la connessione"

#: admin/class-admin-page.php:708
msgid "Copy the files across"
msgstr "Copia i file"

#: admin/class-admin-page.php:712
msgid "Copy the database across"
msgstr "Copia il database"

#: admin/class-admin-page.php:716
msgid "KapsuleHost puts it together"
msgstr "KapsuleHost assembla il tutto"

#: admin/class-admin-page.php:725
msgid "Keep this tab open. We will show your download links the moment packaging finishes."
msgstr "Mantenga aperta questa scheda. Mostreremo i suoi link di download non appena l'impacchettamento sarà completato."

#: admin/class-admin-page.php:727
msgid "<strong>Keep this tab open.</strong> The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "<strong>Mantenga aperta questa scheda.</strong> Il trasferimento viene eseguito da qui, quindi chiudere la scheda lo mette in pausa. Nulla viene perso se lo fa: riapra questa pagina e riprenderà dall'ultima parte arrivata."

#: admin/class-admin-page.php:733
msgid "Stop and start over"
msgstr "Ferma e ricomincia"

#: admin/class-admin-page.php:742
msgid "Package ready"
msgstr "Pacchetto pronto"

#: admin/class-admin-page.php:743
msgid "Your site is packaged"
msgstr "Il suo sito è impacchettato"

#: admin/class-admin-page.php:745
msgid "Download the archives below and import them on your new host. This site has not been changed."
msgstr "Scarichi gli archivi qui sotto e li importi sul suo nuovo host. Questo sito non è stato modificato."

#: admin/class-admin-page.php:755
msgid "Download"
msgstr "Scarica"

#: admin/class-admin-page.php:762
msgid "Moving to KapsuleHost instead? Use the token path and we do all of this for you, with nothing to download."
msgstr "Sta invece trasferendo su KapsuleHost? Usi il percorso token e faremo tutto questo per lei, senza niente da scaricare."

#: admin/class-admin-page.php:766
msgid "Delete the package and start over"
msgstr "Elimina il pacchetto e ricomincia"

#: admin/class-admin-page.php:784
msgid "Move complete"
msgstr "Trasferimento completato"

#: admin/class-admin-page.php:785
msgid "Your site is on KapsuleHost"
msgstr "Il suo sito è su KapsuleHost"

#. translators: %s: number of files copied, already formatted for the locale.
#: admin/class-admin-page.php:788
msgid "%s files and your database were copied and checked. Open the copy and look around before you point your domain at it."
msgstr "%s file e il suo database sono stati copiati e verificati. Apra la copia e dia un'occhiata prima di puntare il suo dominio verso di essa."

#: admin/class-admin-page.php:795
msgid "Files copied"
msgstr "File copiati"

#: admin/class-admin-page.php:799
msgid "Transferred"
msgstr "Trasferiti"

#: admin/class-admin-page.php:803
msgid "Database"
msgstr "Database"

#: admin/class-admin-page.php:804
msgid "Copied"
msgstr "Copiato"

#: admin/class-admin-page.php:807
msgid "Took"
msgstr "Durata"

#. translators: %s: whole number of minutes the migration took.
#: admin/class-admin-page.php:811
msgid "%s min"
msgid_plural "%s min"
msgstr[0] "%s min"
msgstr[1] "%s min"

#: admin/class-admin-page.php:813
msgid "not recorded"
msgstr "non registrato"

#: admin/class-admin-page.php:821
msgid "<strong>This site has not been changed.</strong> It is still live and serving visitors. Nothing moves for your visitors until you point your domain at the new copy."
msgstr "<strong>Questo sito non è stato modificato.</strong> È ancora attivo e serve i visitatori. Niente cambia per i suoi visitatori finché non punta il suo dominio verso la nuova copia."

#: admin/class-admin-page.php:826
msgid "Open the migrated site"
msgstr "Apri il sito migrato"

#: admin/class-admin-page.php:828
msgid "Back to my panel"
msgstr "Torna al mio pannello"

#: admin/class-admin-page.php:837
msgid "Move stopped"
msgstr "Trasferimento interrotto"

#: admin/class-admin-page.php:838
msgid "We stopped before anything changed"
msgstr "Ci siamo fermati prima di apportare modifiche"

#: admin/class-admin-page.php:840
msgid "The move did not finish, so we stopped rather than leave you with half a site. Your site here is untouched and still serving visitors."
msgstr "Il trasferimento non è stato completato, quindi ci siamo fermati piuttosto che lasciarle mezzo sito. Il suo sito qui è intatto e continua a servire i visitatori."

#: admin/class-admin-page.php:851
msgid "Try again"
msgstr "Riprovi"

#: admin/class-admin-page.php:852
msgid "Contact support"
msgstr "Contatti l'assistenza"

#: admin/class-admin-page.php:885
#: assets/js/migrator.js:445
msgid "Checking the connection"
msgstr "Verifica della connessione"

#: admin/class-admin-page.php:886
#: assets/js/migrator.js:446
msgid "Counting your files"
msgstr "Conteggio dei suoi file"

#: admin/class-admin-page.php:887
#: assets/js/migrator.js:333
#: assets/js/migrator.js:447
msgid "Copying files"
msgstr "Copia dei file"

#: admin/class-admin-page.php:888
#: assets/js/migrator.js:422
#: assets/js/migrator.js:448
msgid "Copying database"
msgstr "Copia del database"

#: admin/class-admin-page.php:889
#: assets/js/migrator.js:449
msgid "Packaging"
msgstr "Impacchettamento"

#: admin/class-admin-page.php:890
msgid "Working"
msgstr "In corso"

#. translators: %s: a formatted number of gigabytes, e.g. "5.9".
#: admin/class-admin-page.php:904
#: assets/js/migrator.js:68
msgid "%s GB"
msgstr "%s GB"

#. translators: %s: a formatted number of megabytes.
#: admin/class-admin-page.php:908
#: assets/js/migrator.js:69
msgid "%s MB"
msgstr "%s MB"

#. translators: %s: a formatted number of kilobytes.
#: admin/class-admin-page.php:912
#: assets/js/migrator.js:70
msgid "%s KB"
msgstr "%s KB"

#. translators: %s: a formatted number of bytes.
#: admin/class-admin-page.php:915
#: assets/js/migrator.js:71
msgid "%s B"
msgstr "%s B"

#: includes/class-packager.php:26
msgid "This server cannot create archives, so we cannot package your site. Ask your host to enable the PHP zip extension, then contact KapsuleHost support if it still fails."
msgstr "Questo server non può creare archivi, quindi non possiamo impacchettare il suo sito. Chieda al suo host di abilitare l'estensione PHP zip, poi contatti l'assistenza KapsuleHost se continua a non funzionare."

#: includes/class-uploader.php:112
msgid "We could not read a prepared piece of your site from disk. Free up space on the server and start the migration again."
msgstr "Non siamo riusciti a leggere dal disco una parte preparata del suo sito. Liberi spazio sul server e riavvii la migrazione."

#. translators: %s: an HTTP status code.
#: includes/class-uploader.php:135
msgid "the server replied %s"
msgstr "il server ha risposto %s"

#: includes/class-uploader.php:162
msgid "we could not open the prepared file"
msgstr "non siamo riusciti ad aprire il file preparato"

#. translators: %s: the size of the piece that was rejected, e.g. "50".
#: includes/class-uploader.php:218
msgid "One piece of your site (%s MB) was larger than the server would accept. This is a limit on our side, not a problem with your site. Contact support and we will raise it."
msgstr "Una parte del suo sito (%s MB) era più grande di quanto il server avrebbe accettato. Questo è un limite da parte nostra, non un problema con il suo sito. Contatti l'assistenza e lo aumenteremo."

#: includes/class-uploader.php:223
msgid "Your migration token is no longer valid. Generate a new one in your KapsuleHost panel and paste it in again."
msgstr "Il suo token di migrazione non è più valido. Ne generi uno nuovo nel suo pannello KapsuleHost e lo incolli nuovamente."

#: includes/class-uploader.php:225
msgid "The migration this token belongs to no longer exists. Start a new migration from your KapsuleHost panel."
msgstr "La migrazione a cui appartiene questo token non esiste più. Avvii una nuova migrazione dal suo pannello KapsuleHost."

#: includes/class-uploader.php:227
msgid "The server could not read one of the prepared pieces of your site. Start the migration again to rebuild it."
msgstr "Il server non è riuscito a leggere una delle parti preparate del suo sito. Riavvii la migrazione per ricostruirla."

#. translators: %s: the HTTP status code the server returned.
#: includes/class-uploader.php:231
msgid "The server refused a piece of your site (code %s). Your site has not been changed. Contact support and we will look at it."
msgstr "Il server ha rifiutato una parte del suo sito (codice %s). Il suo sito non è stato modificato. Contatti l'assistenza e la esamineremo."

#: assets/js/migrator.js:77
msgid "less than a minute left"
msgstr "meno di un minuto rimanente"

#. translators: %s: whole number of minutes remaining.
#: assets/js/migrator.js:82
msgid "about %s minute left"
msgid_plural "about %s minutes left"
msgstr[0] "circa %s minuto rimanente"
msgstr[1] "circa %s minuti rimanenti"

#. translators: %s: whole number of hours remaining.
#: assets/js/migrator.js:87
msgid "about %s hour left"
msgid_plural "about %s hours left"
msgstr[0] "circa %s ora rimanente"
msgstr[1] "circa %s ore rimanenti"

#. translators: 1: whole hours remaining, 2: additional minutes remaining.
#: assets/js/migrator.js:90
msgid "about %1$s h %2$s min left"
msgstr "circa %1$s h %2$s min rimanenti"

#: assets/js/migrator.js:192
msgid "Checking your site..."
msgstr "Controllo del suo sito..."

#: assets/js/migrator.js:207
msgid "We could not reach KapsuleHost just now. Check this server can get online, then try again."
msgstr "Non siamo riusciti a raggiungere KapsuleHost in questo momento. Verifichi che questo server possa connettersi online, poi riprovi."

#: assets/js/migrator.js:216
msgid "Packaging..."
msgstr "Impacchettamento..."

#: assets/js/migrator.js:226
#: assets/js/migrator.js:230
msgid "We could not start packaging. Please try again."
msgstr "Non siamo riusciti ad avviare l'impacchettamento. Riprovi."

#: assets/js/migrator.js:237
msgid "Cleaning up..."
msgstr "Pulizia..."

#. translators: 1: which piece is moving, 2: estimated time remaining. Joined into one line.
#: assets/js/migrator.js:264
msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

#. translators: %s: the HTTP status code the server returned, e.g. "502".
#: assets/js/migrator.js:318
msgid "the connection returned %s"
msgstr "la connessione ha restituito %s"

#: assets/js/migrator.js:320
#: assets/js/migrator.js:397
msgid "the connection dropped"
msgstr "la connessione è caduta"

#: assets/js/migrator.js:328
msgid "Keep this tab open."
msgstr "Mantenga aperta questa scheda."

#: assets/js/migrator.js:329
msgid "The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "Il trasferimento viene eseguito da qui, quindi chiudere la scheda lo mette in pausa. Nulla viene perso se lo fa: riapra questa pagina e riprenderà dall'ultima parte arrivata."

#: assets/js/migrator.js:350
msgid "Retrying"
msgstr "Nuovo tentativo"

#: assets/js/migrator.js:351
msgid "The connection dropped"
msgstr "La connessione è caduta"

#. translators: %s: the number of the piece being retried.
#: assets/js/migrator.js:353
msgid "We are retrying piece %s. Everything already sent is kept, so this carries on from where it stopped rather than starting again."
msgstr "Stiamo ritentando la parte %s. Tutto ciò che è già stato inviato è conservato, quindi questo riprende da dove si è fermato piuttosto che ricominciare."

#: assets/js/migrator.js:356
msgid "Attempt"
msgstr "Tentativo"

#: assets/js/migrator.js:357
msgid "Nothing has been lost. Your site is untouched and still serving visitors. If this keeps failing we will tell you exactly what to do next."
msgstr "Nulla è andato perso. Il suo sito è intatto e continua a servire i visitatori. Se questo continua a fallire le diremo esattamente cosa fare."

#. translators: 1: seconds until the next attempt, 2: the attempt number, 3: total attempts.
#: assets/js/migrator.js:365
msgid "retrying in %1$s second, attempt %2$s of %3$s"
msgid_plural "retrying in %1$s seconds, attempt %2$s of %3$s"
msgstr[0] "nuovo tentativo tra %1$s secondo, tentativo %2$s di %3$s"
msgstr[1] "nuovo tentativo tra %1$s secondi, tentativo %2$s di %3$s"

#. translators: 1: the attempt number, 2: total attempts.
#: assets/js/migrator.js:370
msgid "retrying now, attempt %1$s of %2$s"
msgstr "nuovo tentativo ora, tentativo %1$s di %2$s"

#: assets/js/migrator.js:393
msgid "Paused"
msgstr "In pausa"

#: assets/js/migrator.js:394
msgid "We have paused the move"
msgstr "Abbiamo messo in pausa il trasferimento"

#. translators: 1: how many attempts were made, 2: why the connection failed.
#: assets/js/migrator.js:396
msgid "We could not reach KapsuleHost after %1$s tries (%2$s). Nothing is lost. Everything already copied is still there, and this site has not been changed."
msgstr "Non siamo riusciti a raggiungere KapsuleHost dopo %1$s tentativi (%2$s). Nulla è andato perso. Tutto ciò che è già stato copiato è ancora lì, e questo sito non è stato modificato."

#: assets/js/migrator.js:399
msgid "Stopped at"
msgstr "Fermato a"

#. translators: %s: describes which piece the transfer stopped on, e.g. "piece 57 of 119".
#: assets/js/migrator.js:401
msgid "paused at %s"
msgstr "in pausa a %s"

#: assets/js/migrator.js:402
msgid "Check this server can reach the internet, then pick up where you left off. Nothing needs to be re-sent."
msgstr "Verifichi che questo server possa raggiungere internet, poi riprenda da dove si era fermato. Niente deve essere reinviato."

#: assets/js/migrator.js:406
msgid "Pick up where it stopped"
msgstr "Riprendi da dove si è fermato"

#: assets/js/migrator.js:423
msgid "Copying your database"
msgstr "Copia del suo database"

#: assets/js/migrator.js:424
msgid "The files are across. We are copying your database now, which is usually the quickest part."
msgstr "I file sono stati trasferiti. Ora stiamo copiando il suo database, che di solito è la parte più rapida."

#: assets/js/migrator.js:426
#: assets/js/migrator.js:509
msgid "database"
msgstr "database"

#: assets/js/migrator.js:434
msgid "finishing"
msgstr "finalizzazione"
