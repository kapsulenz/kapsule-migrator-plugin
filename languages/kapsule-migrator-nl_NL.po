#. Plugin Name of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost Migrator"
msgstr "KapsuleHost Migrator"

#. Plugin URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com/migrate"
msgstr "https://kapsulehost.com/migrate"

#. Description of the plugin
#: kapsule-migrator.php
msgid "Migrate your WordPress site to KapsuleHost, or export your site for manual migration anywhere."
msgstr "Verplaats uw WordPress-site naar KapsuleHost, of exporteer uw site voor handmatige migratie elders."

#. Author of the plugin
#: kapsule-migrator.php
msgid "KapsuleHost"
msgstr "KapsuleHost"

#. Author URI of the plugin
#: kapsule-migrator.php
msgid "https://kapsulehost.com"
msgstr "https://kapsulehost.com"

#: admin/class-admin-page.php:66
msgid "The migration ended in a state we do not recognise, so we stopped rather than guess. Your site here is untouched."
msgstr "De migratie eindigde in een status die we niet herkennen, dus we zijn gestopt in plaats van te gissen. Uw site hier is onaangeroerd."

#. translators: %s: an HTTP status code, e.g. "503".
#: admin/class-admin-page.php:203
msgid "KapsuleHost answered %s when we asked about your move."
msgstr "KapsuleHost antwoordde %s toen we vroegen naar uw verhuizing."

#: admin/class-admin-page.php:214
msgid "KapsuleHost sent an answer we could not read."
msgstr "KapsuleHost stuurde een antwoord dat we niet konden lezen."

#: admin/class-admin-page.php:260
#: admin/class-admin-page.php:305
#: admin/class-admin-page.php:391
#: admin/class-admin-page.php:492
#: admin/class-admin-page.php:592
#: admin/class-admin-page.php:623
msgid "You do not have permission to do that. Ask an administrator of this site to run the migration."
msgstr "U hebt geen toestemming om dat te doen. Vraag een beheerder van deze site om de migratie uit te voeren."

#: admin/class-admin-page.php:311
#: assets/js/migrator.js:187
msgid "Paste your migration token first. You will find it in your KapsuleHost panel under Sites, then Migrate."
msgstr "Plak eerst uw migratietoken. U vindt deze in uw KapsuleHost-paneel onder Sites, vervolgens Migrate."

#: admin/class-admin-page.php:335
#: assets/js/migrator.js:203
msgid "We could not connect to KapsuleHost with that token. Check it and try again."
msgstr "We konden geen verbinding maken met KapsuleHost met dat token. Controleer het en probeer het opnieuw."

#: admin/class-admin-page.php:416
#: admin/class-admin-page.php:500
msgid "This migration is no longer in a state we can continue from. Stop and start over to begin a clean run."
msgstr "Deze migratie bevindt zich niet langer in een status waaruit we kunnen verdergaan. Stop en begin opnieuw voor een schone start."

#: admin/class-admin-page.php:682
msgid "You do not have permission to download this file."
msgstr "U hebt geen toestemming om dit bestand te downloaden."

#: admin/class-admin-page.php:689
msgid "That download link has expired. Reload this page and try again."
msgstr "Die downloadlink is verlopen. Herlaad deze pagina en probeer het opnieuw."

#: admin/class-admin-page.php:694
msgid "We could not find that file. The package may have been cleaned up, so package this site again."
msgstr "We konden dat bestand niet vinden. Het pakket is mogelijk opgeruimd, dus maak een nieuw pakket van deze site."

#: admin/class-admin-page.php:701
msgid "That file is no longer on this server. Package this site again to rebuild it."
msgstr "Dat bestand staat niet meer op deze server. Maak opnieuw een pakket van deze site om het te herstellen."

#: admin/class-admin-page.php:798
msgid "Move to KapsuleHost"
msgstr "Verhuizen naar KapsuleHost"

#: admin/class-admin-page.php:799
msgid "Download a copy"
msgstr "Download een kopie"

#: admin/class-admin-page.php:804
msgid "Step 1 of 1"
msgstr "Stap 1 van 1"

#: admin/class-admin-page.php:805
msgid "Move this site to KapsuleHost"
msgstr "Verplaats deze site naar KapsuleHost"

#: admin/class-admin-page.php:807
msgid "Paste the migration token from your KapsuleHost panel. We copy your files and your database across and leave this site exactly as it is, serving visitors the whole time."
msgstr "Plak het migratietoken uit uw KapsuleHost-paneel. We kopiëren uw bestanden en uw database en laten deze site precies zoals die is, zodat bezoekers de hele tijd bediend worden."

#: admin/class-admin-page.php:811
msgid "Migration token"
msgstr "Migratietoken"

#: admin/class-admin-page.php:813
msgid "Paste your token"
msgstr "Plak uw token"

#: admin/class-admin-page.php:815
msgid "Find it in your panel under Sites, then Migrate. The token works once and is deleted when the move finishes."
msgstr "U vindt deze in uw paneel onder Sites, vervolgens Migrate. Het token werkt één keer en wordt verwijderd wanneer de verhuizing klaar is."

#: admin/class-admin-page.php:825
msgid "How long this takes depends on how fast this server can upload. Small sites finish in a few minutes and large ones take longer; you will see a live estimate once the transfer starts. If it is interrupted, reopen this page and it carries on from the last piece that arrived."
msgstr "Hoe lang dit duurt hangt af van hoe snel deze server kan uploaden. Kleine sites zijn klaar in een paar minuten en grote duren langer; u ziet een actuele schatting zodra de overdracht begint. Als deze wordt onderbroken, heropen dan deze pagina en hij gaat verder vanaf het laatste stuk dat aankwam."

#: admin/class-admin-page.php:830
#: assets/js/migrator.js:204
#: assets/js/migrator.js:208
msgid "Start the move"
msgstr "Start de verhuizing"

#: admin/class-admin-page.php:840
msgid "Encrypted end to end"
msgstr "Van begin tot eind versleuteld"

#: admin/class-admin-page.php:841
msgid "This site is only ever read, never changed"
msgstr "Deze site wordt alleen gelezen, nooit gewijzigd"

#: admin/class-admin-page.php:842
msgid "Token deleted after use"
msgstr "Token verwijderd na gebruik"

#: admin/class-admin-page.php:848
msgid "No account needed"
msgstr "Geen account nodig"

#: admin/class-admin-page.php:849
msgid "Download a copy of this site"
msgstr "Download een kopie van deze site"

#: admin/class-admin-page.php:851
msgid "Package the files and database into archives you can download and take anywhere. Useful if you are moving by hand or want a copy before you change anything."
msgstr "Pak de bestanden en database in archieven die u kunt downloaden en overal naartoe kunt brengen. Handig als u handmatig verhuist of een kopie wilt voordat u iets wijzigt."

#: admin/class-admin-page.php:855
#: assets/js/migrator.js:227
#: assets/js/migrator.js:231
msgid "Package this site"
msgstr "Maak een pakket van deze site"

#: admin/class-admin-page.php:865
msgid "Files stay on your server until you download them"
msgstr "Bestanden blijven op uw server totdat u ze downloadt"

#: admin/class-admin-page.php:866
msgid "wp-config.php is left out on purpose"
msgstr "wp-config.php is met opzet weggelaten"

#: admin/class-admin-page.php:891
msgid "Packaging your site"
msgstr "Uw site wordt verpakt"

#: admin/class-admin-page.php:892
msgid "We are building downloadable archives of your files and database. Keep this tab open."
msgstr "We maken downloadbare archieven van uw bestanden en database. Houd dit tabblad open."

#: admin/class-admin-page.php:894
#: admin/class-admin-page.php:1302
msgid "Looking at your site"
msgstr "Uw site wordt gecontroleerd"

#: admin/class-admin-page.php:895
msgid "We are counting your files and checking the connection to KapsuleHost. Nothing has moved yet."
msgstr "We tellen uw bestanden en controleren de verbinding met KapsuleHost. Er is nog niets verplaatst."

#: admin/class-admin-page.php:897
#: assets/js/migrator.js:334
msgid "Moving your site"
msgstr "Uw site wordt verplaatst"

#: admin/class-admin-page.php:898
#: assets/js/migrator.js:335
msgid "Your site is being copied across in pieces. It stays live and unchanged the whole time."
msgstr "Uw site wordt in stukken gekopieerd. De site blijft de hele tijd live en ongewijzigd."

#. translators: 1: current piece number, 2: total number of pieces.
#: admin/class-admin-page.php:917
#: assets/js/migrator.js:156
msgid "piece %1$s of %2$s"
msgstr "stuk %1$s van %2$s"

#: admin/class-admin-page.php:931
msgid "Pieces sent"
msgstr "Stukken verzonden"

#: admin/class-admin-page.php:935
msgid "Moved"
msgstr "Verplaatst"

#: admin/class-admin-page.php:939
msgid "Total"
msgstr "Totaal"

#: admin/class-admin-page.php:943
#: assets/js/migrator.js:337
msgid "Files"
msgstr "Bestanden"

#: admin/class-admin-page.php:951
msgid "Count the files and check the connection"
msgstr "Tel de bestanden en controleer de verbinding"

#: admin/class-admin-page.php:955
msgid "Copy the files across"
msgstr "Kopieer de bestanden"

#: admin/class-admin-page.php:959
msgid "Copy the database across"
msgstr "Kopieer de database"

#: admin/class-admin-page.php:963
msgid "KapsuleHost puts it together"
msgstr "KapsuleHost zet alles samen"

#: admin/class-admin-page.php:972
msgid "Keep this tab open. We will show your download links the moment packaging finishes."
msgstr "Houd dit tabblad open. We tonen uw downloadlinks zodra het verpakken klaar is."

#: admin/class-admin-page.php:974
msgid "<strong>Keep this tab open.</strong> The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "<strong>Houd dit tabblad open.</strong> De verplaatsing loopt vanaf hier, dus als u het tabblad sluit wordt de verplaatsing gepauzeerd. Er gaat niets verloren als u dat doet: open deze pagina opnieuw en de verplaatsing gaat verder vanaf het laatste stuk dat is aangekomen."

#: admin/class-admin-page.php:980
msgid "Stop and start over"
msgstr "Stop en begin opnieuw"

#: admin/class-admin-page.php:989
msgid "Package ready"
msgstr "Pakket gereed"

#: admin/class-admin-page.php:990
msgid "Your site is packaged"
msgstr "Uw site is verpakt"

#: admin/class-admin-page.php:992
msgid "Download the archives below and import them on your new host. This site has not been changed."
msgstr "Download de archieven hieronder en importeer ze op uw nieuwe host. Deze site is niet gewijzigd."

#: admin/class-admin-page.php:1002
msgid "Download"
msgstr "Download"

#: admin/class-admin-page.php:1009
msgid "Moving to KapsuleHost instead? Use the token path and we do all of this for you, with nothing to download."
msgstr "Verhuist u toch naar KapsuleHost? Gebruik het tokentraject en wij doen dit allemaal voor u, zonder dat u iets hoeft te downloaden."

#: admin/class-admin-page.php:1013
msgid "Delete the package and start over"
msgstr "Verwijder het pakket en begin opnieuw"

#: admin/class-admin-page.php:1031
#: admin/class-admin-page.php:1115
msgid "Move stopped"
msgstr "Verplaatsing gestopt"

#: admin/class-admin-page.php:1032
msgid "We stopped before anything changed"
msgstr "We zijn gestopt voordat er iets is gewijzigd"

#: admin/class-admin-page.php:1034
msgid "The move did not finish, so we stopped rather than leave you with half a site. Your site here is untouched and still serving visitors."
msgstr "De verplaatsing is niet voltooid, dus zijn we gestopt om te voorkomen dat u met een halve site achterblijft. Uw site hier is onaangetast en bedient nog steeds bezoekers."

#: admin/class-admin-page.php:1045
msgid "Try again"
msgstr "Probeer opnieuw"

#: admin/class-admin-page.php:1046
#: admin/class-admin-page.php:1145
#: admin/class-admin-page.php:1163
msgid "Contact support"
msgstr "Neem contact op met support"

#: admin/class-admin-page.php:1086
msgid "Checking"
msgstr "Controleren"

#: admin/class-admin-page.php:1087
msgid "Your files are with KapsuleHost"
msgstr "Uw bestanden zijn bij KapsuleHost"

#: admin/class-admin-page.php:1088
msgid "Everything uploaded from this site. We cannot reach KapsuleHost right now to tell you what has happened since, so we will not guess: open your panel to see where the move has got to."
msgstr "Alles is geüpload vanaf deze site. We kunnen KapsuleHost op dit moment niet bereiken om u te vertellen wat er daarna is gebeurd, dus we gaan niet gissen: open uw panel om te zien hoe ver de verplaatsing is."

#: admin/class-admin-page.php:1097
msgid "This site has not been changed and is still serving visitors, whatever the move is doing."
msgstr "Deze site is niet gewijzigd en bedient nog steeds bezoekers, wat de verplaatsing ook doet."

#: admin/class-admin-page.php:1100
msgid "Check again"
msgstr "Controleer opnieuw"

#: admin/class-admin-page.php:1101
msgid "Open my panel"
msgstr "Open mijn panel"

#: admin/class-admin-page.php:1116
msgid "The move did not finish"
msgstr "De verhuizing is niet voltooid"

#: admin/class-admin-page.php:1117
msgid "Your files reached KapsuleHost, but putting the site together did not finish. Nothing here has changed: this site is untouched and still serving visitors, and nothing has moved for anyone visiting it."
msgstr "Uw bestanden zijn bij KapsuleHost aangekomen, maar het samenstellen van de site is niet voltooid. Hier is niets gewijzigd: deze site is onaangeroerd en bedient nog steeds bezoekers, en er is niets veranderd voor wie de site bezoekt."

#: admin/class-admin-page.php:1122
#: assets/js/migrator.js:399
msgid "Stopped at"
msgstr "Gestopt bij"

#: admin/class-admin-page.php:1126
msgid "Files placed"
msgstr "Bestanden geplaatst"

#: admin/class-admin-page.php:1127
msgid "Yes"
msgstr "Ja"

#: admin/class-admin-page.php:1127
msgid "No"
msgstr "Nee"

#: admin/class-admin-page.php:1130
#: admin/class-admin-page.php:1260
msgid "Database"
msgstr "Database"

#: admin/class-admin-page.php:1131
#: admin/class-admin-page.php:1261
msgid "Imported"
msgstr "Geïmporteerd"

#: admin/class-admin-page.php:1131
#: admin/class-admin-page.php:1261
msgid "Not imported"
msgstr "Niet geïmporteerd"

#: admin/class-admin-page.php:1144
msgid "See the details in my panel"
msgstr "Bekijk de details in mijn paneel"

#: admin/class-admin-page.php:1146
msgid "Start over from here"
msgstr "Opnieuw beginnen vanaf hier"

#: admin/class-admin-page.php:1158
msgid "Needs a look"
msgstr "Vereist aandacht"

#: admin/class-admin-page.php:1159
msgid "Part of your site moved"
msgstr "Een deel van uw site is verhuisd"

#: admin/class-admin-page.php:1160
msgid "Some of the move finished and some of it did not, so we are not calling it done. Your panel lists exactly what came across and what is still here. This site is untouched and still serving visitors."
msgstr "Een deel van de verhuizing is voltooid en een deel niet, dus we noemen het niet afgerond. Uw paneel toont precies wat is overgekomen en wat hier nog is. Deze site is onaangeroerd en bedient nog steeds bezoekers."

#: admin/class-admin-page.php:1162
msgid "See what moved"
msgstr "Bekijk wat is verhuisd"

#: admin/class-admin-page.php:1178
#: admin/class-admin-page.php:1345
msgid "Working"
msgstr "Bezig"

#: admin/class-admin-page.php:1179
msgid "KapsuleHost is putting your site together"
msgstr "KapsuleHost stelt uw site samen"

#: admin/class-admin-page.php:1180
msgid "Everything uploaded from this site. KapsuleHost is unpacking it, importing your database and checking the result. We will show you the outcome here, and it is safe to close this tab."
msgstr "Alles is geüpload vanaf deze site. KapsuleHost pakt het uit, importeert uw database en controleert het resultaat. We tonen u het resultaat hier, en u kunt dit tabblad veilig sluiten."

#: admin/class-admin-page.php:1198
msgid "<strong>This site has not been changed.</strong> It is still live and serving visitors, and nothing moves for them until you point your domain at the new copy."
msgstr "<strong>Deze site is niet gewijzigd.</strong> De site is nog steeds live en bedient bezoekers, en er verandert niets voor hen totdat u uw domein naar de nieuwe kopie verwijst."

#: admin/class-admin-page.php:1202
msgid "Follow it in my panel"
msgstr "Volg het in mijn paneel"

#: admin/class-admin-page.php:1241
msgid "Move complete"
msgstr "Verhuizing voltooid"

#: admin/class-admin-page.php:1242
msgid "Your site is on KapsuleHost"
msgstr "Uw site staat op KapsuleHost"

#. translators: %s: number of files this site sent, already formatted for the locale.
#: admin/class-admin-page.php:1245
msgid "KapsuleHost has finished putting your site together from the %s files this site sent. Open the copy and look around before you point your domain at it."
msgstr "KapsuleHost heeft uw site samengesteld uit de %s bestanden die deze site heeft verzonden. Open de kopie en kijk rond voordat u uw domein ernaar verwijst."

#: admin/class-admin-page.php:1252
msgid "Files sent"
msgstr "Bestanden verzonden"

#: admin/class-admin-page.php:1256
msgid "Transferred"
msgstr "Overgedragen"

#: admin/class-admin-page.php:1264
msgid "Your copy"
msgstr "Uw kopie"

#: admin/class-admin-page.php:1265
msgid "in your panel"
msgstr "in uw paneel"

#: admin/class-admin-page.php:1271
msgid "<strong>This site has not been changed.</strong> It is still live and serving visitors. Nothing moves for your visitors until you point your domain at the new copy."
msgstr "<strong>Deze site is niet gewijzigd.</strong> De site is nog steeds live en bedient bezoekers. Er verandert niets voor uw bezoekers totdat u uw domein naar de nieuwe kopie verwijst."

#: admin/class-admin-page.php:1276
msgid "Open the migrated site"
msgstr "Open de verhuisde site"

#: admin/class-admin-page.php:1279
msgid "See the move in my panel"
msgstr "Bekijk de verhuizing in mijn paneel"

#: admin/class-admin-page.php:1281
msgid "Back to my panel"
msgstr "Terug naar mijn paneel"

#: admin/class-admin-page.php:1299
msgid "Waiting to start"
msgstr "Wacht op start"

#: admin/class-admin-page.php:1300
msgid "Checking what arrived"
msgstr "Controleert wat is aangekomen"

#: admin/class-admin-page.php:1301
msgid "Connecting"
msgstr "Verbinden"

#: admin/class-admin-page.php:1303
msgid "Building your new environment"
msgstr "Bouwt uw nieuwe omgeving"

#: admin/class-admin-page.php:1304
msgid "Moving your files to the server"
msgstr "Uw bestanden naar de server verplaatsen"

#: admin/class-admin-page.php:1305
msgid "Unpacking your files"
msgstr "Uw bestanden uitpakken"

#: admin/class-admin-page.php:1306
msgid "Putting the files in place"
msgstr "De bestanden op hun plaats zetten"

#: admin/class-admin-page.php:1307
#: admin/class-admin-page.php:1341
#: assets/js/migrator.js:333
#: assets/js/migrator.js:522
msgid "Copying files"
msgstr "Bestanden kopiëren"

#: admin/class-admin-page.php:1308
msgid "Importing your database"
msgstr "Uw database importeren"

#: admin/class-admin-page.php:1309
msgid "Rewriting the addresses in your site"
msgstr "De adressen in uw site herschrijven"

#: admin/class-admin-page.php:1310
msgid "Checking the result serves"
msgstr "Controleren of het resultaat wordt weergegeven"

#: admin/class-admin-page.php:1311
msgid "Finished"
msgstr "Voltooid"

#: admin/class-admin-page.php:1339
#: assets/js/migrator.js:520
msgid "Checking the connection"
msgstr "De verbinding controleren"

#: admin/class-admin-page.php:1340
#: assets/js/migrator.js:521
msgid "Counting your files"
msgstr "Uw bestanden tellen"

#: admin/class-admin-page.php:1342
#: assets/js/migrator.js:434
#: assets/js/migrator.js:523
msgid "Copying database"
msgstr "Database kopiëren"

#: admin/class-admin-page.php:1343
#: assets/js/migrator.js:524
msgid "KapsuleHost is working on it"
msgstr "KapsuleHost is ermee bezig"

#: admin/class-admin-page.php:1344
#: assets/js/migrator.js:525
msgid "Packaging"
msgstr "Inpakken"

#. translators: %s: a formatted number of gigabytes, e.g. "5.9".
#: admin/class-admin-page.php:1359
#: assets/js/migrator.js:68
msgid "%s GB"
msgstr "%s GB"

#. translators: %s: a formatted number of megabytes.
#: admin/class-admin-page.php:1363
#: assets/js/migrator.js:69
msgid "%s MB"
msgstr "%s MB"

#. translators: %s: a formatted number of kilobytes.
#: admin/class-admin-page.php:1367
#: assets/js/migrator.js:70
msgid "%s KB"
msgstr "%s KB"

#. translators: %s: a formatted number of bytes.
#: admin/class-admin-page.php:1370
#: assets/js/migrator.js:71
msgid "%s B"
msgstr "%s B"

#: includes/class-packager.php:26
msgid "This server cannot create archives, so we cannot package your site. Ask your host to enable the PHP zip extension, then contact KapsuleHost support if it still fails."
msgstr "Deze server kan geen archieven aanmaken, dus we kunnen uw site niet inpakken. Vraag uw host om de PHP zip-extensie in te schakelen en neem daarna contact op met de ondersteuning van KapsuleHost als het nog steeds niet lukt."

#. translators: %s: the placeholder token found in the export.
#: includes/class-packager.php:467
msgid "We built a copy of your database and then found it was not safe to send: it still contains an internal placeholder (%s) where your content has a percent sign. Sending it would have changed your links, styling and settings. Nothing has been uploaded and your site is untouched. Please contact KapsuleHost support and quote this message."
msgstr "We hebben een kopie van uw database gemaakt en daarna geconstateerd dat deze niet veilig kan worden verzonden: er staat nog een interne tijdelijke aanduiding (%s) waar uw content een procentteken bevat. Verzenden zou uw links, opmaak en instellingen hebben gewijzigd. Er is niets geüpload en uw site is ongewijzigd. Neemt u alstublieft contact op met de ondersteuning van KapsuleHost en vermeld deze melding."

#: includes/class-uploader.php:112
msgid "We could not read a prepared piece of your site from disk. Free up space on the server and start the migration again."
msgstr "We konden een voorbereid onderdeel van uw site niet van de schijf lezen. Maak ruimte vrij op de server en start de migratie opnieuw."

#. translators: %s: an HTTP status code.
#: includes/class-uploader.php:135
msgid "the server replied %s"
msgstr "de server antwoordde %s"

#: includes/class-uploader.php:162
msgid "we could not open the prepared file"
msgstr "we konden het voorbereide bestand niet openen"

#. translators: %s: the size of the piece that was rejected, e.g. "50".
#: includes/class-uploader.php:218
msgid "One piece of your site (%s MB) was larger than the server would accept. This is a limit on our side, not a problem with your site. Contact support and we will raise it."
msgstr "Eén onderdeel van uw site (%s MB) was groter dan de server zou accepteren. Dit is een limiet aan onze kant, geen probleem met uw site. Neem contact op met de ondersteuning en we zullen deze verhogen."

#: includes/class-uploader.php:223
msgid "Your migration token is no longer valid. Generate a new one in your KapsuleHost panel and paste it in again."
msgstr "Uw migratietoken is niet meer geldig. Maak een nieuwe aan in uw KapsuleHost-panel en plak deze opnieuw in."

#: includes/class-uploader.php:225
msgid "The migration this token belongs to no longer exists. Start a new migration from your KapsuleHost panel."
msgstr "De migratie waartoe dit token behoort, bestaat niet meer. Start een nieuwe migratie vanuit uw KapsuleHost-panel."

#: includes/class-uploader.php:227
msgid "The server could not read one of the prepared pieces of your site. Start the migration again to rebuild it."
msgstr "De server kon een van de voorbereide onderdelen van uw site niet lezen. Start de migratie opnieuw om deze opnieuw op te bouwen."

#. translators: %s: the HTTP status code the server returned.
#: includes/class-uploader.php:231
msgid "The server refused a piece of your site (code %s). Your site has not been changed. Contact support and we will look at it."
msgstr "De server weigerde een onderdeel van uw site (code %s). Uw site is niet gewijzigd. Neem contact op met de ondersteuning en we zullen ernaar kijken."

#: assets/js/migrator.js:77
msgid "less than a minute left"
msgstr "minder dan een minuut resterend"

#. translators: %s: whole number of minutes remaining.
#: assets/js/migrator.js:82
msgid "about %s minute left"
msgid_plural "about %s minutes left"
msgstr[0] "ongeveer %s minuut resterend"
msgstr[1] "ongeveer %s minuten resterend"

#. translators: %s: whole number of hours remaining.
#: assets/js/migrator.js:87
msgid "about %s hour left"
msgid_plural "about %s hours left"
msgstr[0] "ongeveer %s uur resterend"
msgstr[1] "ongeveer %s uur resterend"

#. translators: 1: whole hours remaining, 2: additional minutes remaining.
#: assets/js/migrator.js:90
msgid "about %1$s h %2$s min left"
msgstr "ongeveer %1$s u %2$s min resterend"

#: assets/js/migrator.js:192
msgid "Checking your site..."
msgstr "Uw site controleren..."

#: assets/js/migrator.js:207
msgid "We could not reach KapsuleHost just now. Check this server can get online, then try again."
msgstr "We konden KapsuleHost momenteel niet bereiken. Controleer of deze server online kan komen en probeer het opnieuw."

#: assets/js/migrator.js:216
msgid "Packaging..."
msgstr "Inpakken..."

#: assets/js/migrator.js:226
#: assets/js/migrator.js:230
msgid "We could not start packaging. Please try again."
msgstr "We konden het inpakken niet starten. Probeer het opnieuw."

#: assets/js/migrator.js:237
msgid "Cleaning up..."
msgstr "Opruimen..."

#. translators: 1: which piece is moving, 2: estimated time remaining. Joined into one line.
#: assets/js/migrator.js:264
msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

#. translators: %s: the HTTP status code the server returned, e.g. "502".
#: assets/js/migrator.js:318
msgid "the connection returned %s"
msgstr "de verbinding gaf %s terug"

#: assets/js/migrator.js:320
#: assets/js/migrator.js:397
msgid "the connection dropped"
msgstr "de verbinding werd verbroken"

#: assets/js/migrator.js:328
msgid "Keep this tab open."
msgstr "Houd dit tabblad open."

#: assets/js/migrator.js:329
msgid "The move runs from here, so closing the tab pauses it. Nothing is lost if you do: reopen this page and it carries on from the last piece that arrived."
msgstr "De verhuizing verloopt vanaf hier, dus als u het tabblad sluit wordt deze gepauzeerd. Er gaat niets verloren als u dat doet: open deze pagina opnieuw en alles gaat verder vanaf het laatste deel dat is aangekomen."

#: assets/js/migrator.js:350
msgid "Retrying"
msgstr "Opnieuw proberen"

#: assets/js/migrator.js:351
msgid "The connection dropped"
msgstr "De verbinding werd verbroken"

#. translators: %s: the number of the piece being retried.
#: assets/js/migrator.js:353
msgid "We are retrying piece %s. Everything already sent is kept, so this carries on from where it stopped rather than starting again."
msgstr "We proberen deel %s opnieuw. Alles wat al verzonden is blijft bewaard, dus dit gaat verder vanaf waar het stopte in plaats van opnieuw te beginnen."

#: assets/js/migrator.js:356
msgid "Attempt"
msgstr "Poging"

#: assets/js/migrator.js:357
msgid "Nothing has been lost. Your site is untouched and still serving visitors. If this keeps failing we will tell you exactly what to do next."
msgstr "Er is niets verloren gegaan. Uw site is onaangeroerd en bedient nog steeds bezoekers. Als dit blijft mislukken vertellen we u precies wat u vervolgens moet doen."

#. translators: 1: seconds until the next attempt, 2: the attempt number, 3: total attempts.
#: assets/js/migrator.js:365
msgid "retrying in %1$s second, attempt %2$s of %3$s"
msgid_plural "retrying in %1$s seconds, attempt %2$s of %3$s"
msgstr[0] "opnieuw proberen over %1$s seconde, poging %2$s van %3$s"
msgstr[1] "opnieuw proberen over %1$s seconden, poging %2$s van %3$s"

#. translators: 1: the attempt number, 2: total attempts.
#: assets/js/migrator.js:370
msgid "retrying now, attempt %1$s of %2$s"
msgstr "nu opnieuw proberen, poging %1$s van %2$s"

#: assets/js/migrator.js:393
msgid "Paused"
msgstr "Gepauzeerd"

#: assets/js/migrator.js:394
msgid "We have paused the move"
msgstr "We hebben de verhuizing gepauzeerd"

#. translators: 1: how many attempts were made, 2: why the connection failed.
#: assets/js/migrator.js:396
msgid "We could not reach KapsuleHost after %1$s tries (%2$s). Nothing is lost. Everything already copied is still there, and this site has not been changed."
msgstr "We konden KapsuleHost niet bereiken na %1$s pogingen (%2$s). Er is niets verloren gegaan. Alles wat al gekopieerd is staat er nog, en deze site is niet gewijzigd."

#. translators: %s: describes which piece the transfer stopped on, e.g. "piece 57 of 119".
#: assets/js/migrator.js:401
msgid "paused at %s"
msgstr "gepauzeerd bij %s"

#: assets/js/migrator.js:402
msgid "Check this server can reach the internet, then pick up where you left off. Nothing needs to be re-sent."
msgstr "Controleer of deze server het internet kan bereiken en ga dan verder waar u gebleven was. Er hoeft niets opnieuw verzonden te worden."

#: assets/js/migrator.js:406
msgid "Pick up where it stopped"
msgstr "Verder gaan waar het stopte"

#: assets/js/migrator.js:435
msgid "Copying your database"
msgstr "Uw database wordt gekopieerd"

#: assets/js/migrator.js:436
msgid "The files are across. We are copying your database now, which is usually the quickest part."
msgstr "De bestanden zijn over. We kopiëren nu uw database, wat meestal het snelste deel is."

#: assets/js/migrator.js:438
#: assets/js/migrator.js:585
msgid "database"
msgstr "database"

#: assets/js/migrator.js:447
msgid "Handing over to KapsuleHost"
msgstr "Overdragen aan KapsuleHost"

#: assets/js/migrator.js:449
msgid "everything sent"
msgstr "alles verzonden"

#: assets/js/migrator.js:478
#: assets/js/migrator.js:500
msgid "we cannot reach KapsuleHost just now, still trying"
msgstr "we kunnen KapsuleHost op dit moment niet bereiken, nog aan het proberen"

#: assets/js/migrator.js:507
msgid "Checking..."
msgstr "Controleren..."
